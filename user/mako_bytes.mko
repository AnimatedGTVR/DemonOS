namespace MakoBytes;

# U1 of docs/mako-userspace-improvements.md, Finding 4 (byte-buffer half
# only -- see the file-level note in browser_client.mko for why the shared
# bitmap-font renderer is deliberately NOT part of this pass). MKO has no
# built-in memset/memcpy; `browser_client.mko` hand-rolled its own
# byte-at-a-time zero/copy/read loops under names (`clear_bytes`,
# `copy_bytes`, `get_byte`) that describe raw buffer operations, not
# anything text-specific -- despite living in the one file that happens to
# need them today, this is a generic byte-buffer gap, not a string one.

fn zero(address: u64, count: u64) -> u64 {
    bytes: vptr<u8> = vptr_from_u8(address);
    index: u64 = 0;
    while index < count {
        vptr_write_u8(vptr_offset_u8(bytes, index), 0);
        index = index + 1;
    }
    return 0;
}

fn copy(destination: u64, source: u64, count: u64) -> u64 {
    output: vptr<u8> = vptr_from_u8(destination);
    source_bytes: vptr<u8> = vptr_from_u8(source);
    index: u64 = 0;
    while index < count {
        vptr_write_u8(vptr_offset_u8(output, index),
                      vptr_read_u8(vptr_offset_u8(source_bytes, index)));
        index = index + 1;
    }
    return count;
}

# Reads one byte out of a buffer addressed as u64 words rather than u8 --
# useful when the rest of a caller's buffer handling is already word-based
# (browser_client.mko's page-content words) and switching the whole buffer
# to a vptr<u8> view isn't otherwise wanted.
fn byte_at(address: u64, offset: u64) -> u64 {
    word_index: u64 = offset / 8;
    byte_index: u64 = offset - word_index * 8;
    divisor: u64 = 1;
    while byte_index > 0 {
        divisor = divisor * 256;
        byte_index = byte_index - 1;
    }
    value: u64 = vptr_read_u64(vptr_offset_u64(vptr_from_u64(address), word_index));
    value = value / divisor;
    return value - (value / 256) * 256;
}
