use "sdk.mko";
use "../Desktop/desktop_edde.mko";

# EDDE (Equinox Desktop DemonOS Environment) fork: an independent copy of
# compositor.mko, taken at the point where the EDE port work landed, kept
# separately buildable/evolvable as its own GRUB boot entry ("EDDE") rather
# than editing the original DemonOS desktop shell in place. Both binaries
# build from separate `use` graphs (this file imports desktop_edde.mko, not
# desktop.mko) and are installed to the SAME RAMFS path
# (/system/bin/compositor.elf) by different GRUB menuentries, so the
# kernel's spawn logic in src/kernel.c needs no changes at all -- whichever
# ELF a given boot's grub.cfg module2 line maps to that path is "the
# compositor" for that session.

# Native ring-3 compositor. This file owns display capability use, window
# surfaces, z-order, focus, input routing, and bounded presentation. Desktop
# shell policy and appearance live in Desktop/desktop.mko.
#
# Window table: MKO's kernel profile has no structs/arrays (verified against
# the compiler: `struct construction` and `list` are both rejected under
# `--kernel`), so the table is a fixed-capacity slot-stride memory region
# addressed via vptr offset arithmetic, the same trick already used to pack
# x/y/width/height into u64 words. WINDOW_TABLE_BASE sits past every other
# scratch buffer in the process heap (request/pixel scratch tops out around
# 0x328078; the table starts at 0x328100 and uses 640 bytes). These
# addresses shifted by 0x6000 (24576) when USERSPACE_CODE_PAGES grew from 24
# to 30 pages to fit the compositor's loading/login screens and taskbar
# text, then by another 0x4000 (16384) when it grew again from 30 to 34
# pages to fit the close-fade/wiggle animation work, then by 0x2000 for the
# native session loading/login work -- see the comment on
# USERSPACE_CODE_PAGES in kernel/userspace.h.
# The table grew from 512 to 576 bytes when the slot stride widened from 8
# to 9 words to fit open/close transition state (word8), then to 640 bytes
# when it widened again to 10 words to fit an app_kind tag (word9, see
# slot_app_kind); shift EFFECT_REQUEST_BASE (see effect_request_ptr())
# forward with it if the stride or slot count ever changes again.
# EFFECT_REQUEST_BASE sits right after the table at 0x32C380 (3326848) and
# uses 80 bytes, well inside the heap still free before USER_STACK_PAGE
# begins.
#
# Slot stride is 10 u64 words (80 bytes) per window, WINDOW_LIMIT (8) slots:
#   word0: state (0 closed, 1 normal, 2 minimized-normal, 3 maximized,
#                4 minimized-maximized)
#   word1: window_id + z_order * 2^32   (higher z_order = more front)
#   word2: x + y * 2^32
#   word3: width + height * 2^32
#   word4: surface_object_id (0 if this window has no client surface)
#   word5: mapped_surface_address (0 until MakoAbi.surface_map succeeds;
#          each process can hold up to USER_SURFACE_MAP_SLOTS=4 concurrent
#          read-only surface mappings -- see map_surface_readonly in
#          src/arch/x86_64/userspace.c -- which matches SURFACE_LIMIT=4
#          system-wide, so up to 4 windows can have real zero-copy pixels
#          at once; a 5th window's surface_map call fails gracefully and
#          that window falls back to flat placeholder content instead of
#          forged pixels)
#   word6: restore_x + restore_y * 2^32
#   word7: restore_width + restore_height * 2^32
#   word8: anim_start_phase + anim_kind * 2^32 (see slot_anim_kind/
#          slot_set_anim below -- open/close transition state)
#   word9: app_kind (low32) + composition_layer * 2^32 (see
#          slot_app_kind/slot_layer and the app_kind/layer helpers below --
#          which icon/titlebar chrome this window renders with). Every
#          window-creating client shares one CREATE wire format with no
#          per-app tag field of its own (see the wire-format note below),
#          so the compositor instead remembers "the next CREATE is kind X"
#          in pending_spawn_kind (compositor_main) at the moment
#          spawn_app() fires, and the CREATE handler consumes it into this
#          word for the slot it lands in -- see spawn_app's own comment for
#          why this is safe (spawns are strictly one-in-flight at a time
#          from the live launcher).
#
# Wire format (struct demon_window_message in include/demon/window.h):
# low32 of word0 = version (low16) | opcode (high16); high32 of word0 = serial.
# word1 = window_id (low32) | flags (high32). word2 = x | (y << 32).
# word3 = width | (height << 32). word4 = surface_id (low32).
fn glyph_pixel(mask: u64, index: u64, foreground: u64) -> u64 {
    row: u64 = index / 5;
    column: u64 = index - row * 5;
    divisor: u64 = 1;
    step: u64 = 0;
    while step < row { divisor = divisor * 32; step = step + 1; }
    step = 0;
    while step < column { divisor = divisor * 2; step = step + 1; }
    bit: u64 = mask / divisor;
    bit = bit - (bit / 2) * 2;
    if bit == 1 { return foreground; }
    return 0;
}

fn pack_words(low: u64, high: u64) -> u64 {
    return low + high * 4294967296;
}

# UINT64_MAX (the syscall failure sentinel). The MKO native backend
# mis-encodes the raw decimal literal 18446744073709551615 as a
# floating-point constant, which the assembler then rejects -- computing it
# via unsigned wraparound (0 - 1) avoids emitting that literal at all.
fn u64_max() -> u64 {
    zero: u64 = 0;
    return zero - 1;
}

# Resize-direction constants for the 8-zone edge/corner resize state
# machine (see compositor_main's pointer-down hit test and its live_type==3
# resize-drag handler). Values are arbitrary but match the enum
# graphics_cursor_icon ordering conceptually (N,S,E,W,NE,NW,SE,SW) so the
# cursor_icon_for_direction lookup below is a simple 1:1 table, not a
# separate remapping.
fn resize_direction_n() -> u64 { return 1; }
fn resize_direction_s() -> u64 { return 2; }
fn resize_direction_e() -> u64 { return 3; }
fn resize_direction_w() -> u64 { return 4; }
fn resize_direction_ne() -> u64 { return 5; }
fn resize_direction_nw() -> u64 { return 6; }
fn resize_direction_se() -> u64 { return 7; }
fn resize_direction_sw() -> u64 { return 8; }

fn low32(value: u64) -> u64 {
    return value - (value / 4294967296) * 4294967296;
}

fn high32(value: u64) -> u64 {
    return value / 4294967296;
}

# Pack a screen-resolution (0..639, 0..479) cursor position, plus the
# current accent_theme (0-3, see accent_border/accent_fill/etc.), into one
# 32-bit half, since the render_* functions are already at MKO's
# 6-parameter ceiling (every slot taken by display/request/pixel/state/
# anim_phase) and have no room for cursor_x/cursor_y/accent_theme as three
# more separate arguments. 1024 comfortably covers the 640px width with
# headroom to spare; packed cursor maxes at 639 + 479*1024 = 491135, well
# under the 2^20 (1048576) stride given to accent_theme, so the two fields
# never collide.
fn pack_cursor(cursor_x: u64, cursor_y: u64) -> u64 {
    return cursor_x + cursor_y * 1024;
}

fn pack_cursor_and_theme(cursor_x: u64, cursor_y: u64, accent_theme: u64) -> u64 {
    return pack_cursor(cursor_x, cursor_y) + accent_theme * 1048576;
}

# settings_open (0 or 1) packed at 2^22 (4194304), clear of accent_theme's
# 0-3 range at the 2^20 stride below it (max contribution 3*1048576 =
# 3145728 < 4194304).
fn pack_cursor_theme_and_settings(cursor_x: u64, cursor_y: u64,
                                  accent_theme: u64, settings_open: u64) -> u64 {
    return pack_cursor_and_theme(cursor_x, cursor_y, accent_theme) +
           settings_open * 4194304;
}

fn unpack_settings_open(packed: u64) -> u64 {
    return packed / 4194304;
}

# launcher_open (0 or 1) packed at 2^23 (8388608), clear of settings_open's
# 2^22 stride below it, folded into the same cursor/theme/settings word so
# render_scene (already at MKO's 6-parameter ceiling once search_query is
# threaded through) doesn't need launcher_open as its own argument.
fn unpack_launcher_open(packed: u64) -> u64 {
    field: u64 = packed / 8388608;
    return field - (field / 2) * 2;
}

fn unpack_cursor_x(packed: u64) -> u64 {
    return packed - (packed / 1024) * 1024;
}

# Masked to the 1024..1048575 field (cursor_y's stride up to accent_theme's
# stride at 2^20) so a nonzero packed accent_theme -- see
# pack_cursor_and_theme -- doesn't leak into the unpacked cursor_y value.
fn unpack_cursor_y(packed: u64) -> u64 {
    field: u64 = packed / 1024;
    return field - (field / 1024) * 1024;
}

# Masked to 0-3 (accent_theme's own field width, 2^22 / 2^20 = 4) so a
# nonzero packed settings_open bit at 2^22 -- see
# pack_cursor_theme_and_settings -- doesn't leak into the unpacked
# accent_theme value.
fn unpack_accent_theme(packed: u64) -> u64 {
    field: u64 = packed / 1048576;
    return field - (field / 4) * 4;
}

# Triangle wave over [0, amplitude] with the given period (in phase ticks),
# used to drive a slow "breathing" glow without any floating point -- MKO's
# kernel profile has no float support, so animation timing is pure integer
# modulo arithmetic against the phase counter compositor_main advances once
# per idle-heartbeat tick (see anim_phase in compositor_main).
fn anim_pulse(phase: u64, period: u64, amplitude: u64) -> u64 {
    position: u64 = phase - (phase / period) * period;
    half: u64 = period / 2;
    if position < half { return position * amplitude / half; }
    return (period - position) * amplitude / half;
}

# Nudge one channel of a packed 0xAARRGGBB value up by delta, clamped at 255,
# leaving alpha untouched -- used to lighten a focused element's color by the
# current pulse amount without needing per-channel unpack helpers everywhere.
fn argb_lighten(color: u64, delta: u64) -> u64 {
    alpha: u64 = color / 16777216;
    red: u64 = color / 65536 - alpha * 256;
    green: u64 = color / 256 - (color / 65536) * 256;
    blue: u64 = color - (color / 256) * 256;
    red = red + delta;
    if red > 255 { red = 255; }
    green = green + delta;
    if green > 255 { green = 255; }
    blue = blue + delta;
    if blue > 255 { blue = 255; }
    return blue + green * 256 + red * 65536 + alpha * 16777216;
}

# Replace a packed 0xAARRGGBB value's alpha byte, keeping RGB untouched --
# used to fade the window open/close transition overlay between transparent
# and opaque backdrop over anim_transition_ticks() phase ticks.
fn argb_with_alpha(color: u64, alpha: u64) -> u64 {
    return (color - (color / 16777216) * 16777216) + alpha * 16777216;
}

# Named color constants for the dark glass/dock theme (dark translucent
# panels, blue titlebar/accent, colored-dot window controls, dark-blue
# desktop backdrop). MKO's kernel profile has no `const`/`let` (verified:
# only `fn` and inline literals are accepted), so these are zero-arg helper
# functions returning the packed 0xAARRGGBB value, the same idiom
# pack_words()/u64_max() already establish for anything constant-like. Every
# render_* function below calls these instead of inlining raw decimal ARGB
# literals.
fn color_shadow() -> u64 { return 1879048192; }                # #70000000
fn color_window_body() -> u64 { return 3941791740; }           # #EAF2F7FC frosted silver
fn color_window_border() -> u64 { return 4286101990; }         # #FF78B9E6 aqua glass rim

# Aero-glass specular sheen: a bright, fading-to-transparent band drawn near
# the top of a glass panel (window titlebars, the login/loading card, the
# settings popover) to match Desktop/desktop.mko's glass treatment without a
# real blur buffer. Same values as Desktop.desktop_color_glass_sheen_top/
# bottom(), duplicated here rather than cross-namespace-imported since these
# are plain global functions like every other color_* helper in this file.
fn color_glass_sheen_top() -> u64 { return 1895825407; }       # #70FFFFFF
fn color_glass_sheen_bottom() -> u64 { return 2785208; }       # #002A7FB8

# Accent-themed colors: settings_open's panel (see render_settings) lets the
# user pick accent_theme 0-3 at runtime (0=blue, 1=purple, 2=green,
# currently unused index 3 falls back to blue), threaded through
# render_scene/render_window/render_taskbar the same way anim_phase/cursor
# already are (see pack_cursor_and_theme). Theme 0's values are identical to
# the plain color_titlebar_focused_top()/color_start_fill()/etc. constants
# below them (unchanged, still used by anything that doesn't need to react
# to the theme, like color_window_border() above), so switching to theme 0
# is fully behavior-preserving. accent_fill() covers the focused-titlebar-
# top use too (same three values) -- no separate accent_titlebar_top,
# MKO's native backend fully inlines every call site with no code sharing
# (see the RAMFS_DATA_MAX/USERSPACE_CODE_PAGES notes elsewhere in this
# file), so a same-body wrapper function costs a second full copy of the
# branch for zero behavioral benefit.
fn accent_titlebar_bottom(theme: u64) -> u64 {
    if theme == 1 { return 4283050114; }                       # #FF4A2882 purple
    if theme == 2 { return 4279790405; }                       # #FF186B45 green
    return 4280237690;                                          # #FF1F3E7A blue (default)
}
fn accent_fill(theme: u64) -> u64 {
    if theme == 1 { return 4286336452; }                       # #FF7C4DC4 purple
    if theme == 2 { return 4281245291; }                       # #FF2E9E6B green
    return 4282280888;                                          # #FF3E6BB8 blue (default)
}
fn accent_border_bright(theme: u64) -> u64 {
    if theme == 1 { return 4288708320; }                       # #FFA07EE0 purple
    if theme == 2 { return 4284400786; }                       # #FF5EC492 green
    return 4285242080;                                          # #FF6B9AE0 blue (default)
}
fn accent_task_focused(theme: u64) -> u64 {
    if theme == 1 { return 2960936388; }                       # #B07C4DC4 purple
    if theme == 2 { return 2955845227; }                       # #B02E9E6B green
    return 2956880824;                                          # #B03E6BB8 blue (default)
}

