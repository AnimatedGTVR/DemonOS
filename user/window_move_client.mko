use "sdk.mko";

# Generic MOVE sender: repositions whatever window_id it is told to target.
# window_id is not hardcoded -- it is passed in by the entry stub (a plain
# immediate, not a rodata address) so this same client can move any live
# window the caller names, matching the compositor's dynamic window table.
fn window_move_client_main(service_name: u64, window_id: u64) -> u64 {
    packet_address: u64 = 3309568;
    packet: vptr<u64> = vptr_from_u64(packet_address);
    word: u64 = 0;
    while word < 8 {
        vptr_write_u64(vptr_offset_u64(packet, word), 0);
        word = word + 1;
    }
    # version 1, MOVE opcode 10, serial 2.
    vptr_write_u64(packet, 655361 + 2 * 4294967296);
    vptr_write_u64(vptr_offset_u64(packet, 1), window_id);
    vptr_write_u64(vptr_offset_u64(packet, 2), 144 + 64 * 4294967296);
    vptr_write_u64(vptr_offset_u64(packet, 3), 320 + 240 * 4294967296);
    channel: u64 = MakoAbi.channel_connect(service_name, 18);
    if MakoAbi.channel_send(channel, packet_address, 64) != 64 {
        MakoAbi.exit(108); return 108;
    }
    MakoAbi.handle_close(channel);
    MakoAbi.exit(0);
    return 0;
}
