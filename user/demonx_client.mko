use "sdk.mko";

fn pack_words(low: u64, high: u64) -> u64 {
    return low + high * 4294967296;
}

fn clear_packet(packet: vptr<u64>) -> u64 {
    word: u64 = 0;
    while word < 8 {
        vptr_write_u64(vptr_offset_u64(packet, word), 0);
        word = word + 1;
    }
    return 0;
}

fn set_header_for(packet: vptr<u64>, payload_length: u64,
                  flags: u64, client_id: u64, sequence: u64) -> u64 {
    header: u64 = 1479618884 + payload_length * 4294967296 +
        flags * 281474976710656;
    vptr_write_u64(packet, header);
    vptr_write_u64(vptr_offset_u64(packet, 1),
                   client_id + sequence * 4294967296);
    return 0;
}

fn set_header(packet: vptr<u64>, payload_length: u64,
              flags: u64, sequence: u64) -> u64 {
    return set_header_for(packet, payload_length, flags, 1, sequence);
}

fn send_request_for(channel: u64, packet: vptr<u64>,
                    first: u64, second: u64,
                    client_id: u64, sequence: u64) -> u64 {
    clear_packet(packet);
    set_header_for(packet, 8, 0, client_id, sequence);
    vptr_write_u64(vptr_offset_u64(packet, 2), first + second * 4294967296);
    return MakoAbi.channel_send(channel, 3342336, 64);
}

fn send_request(channel: u64, packet_address: u64, packet: vptr<u64>,
                first: u64, second: u64, sequence: u64) -> u64 {
    return send_request_for(channel, packet,
                            first, second, 1, sequence);
}

fn demonx_client_main(service_name: u64, reply_name: u64,
                      reply_name2: u64) -> u64 {
    packet_address: u64 = 3342336;
    packet: vptr<u64> = vptr_from_u64(packet_address);
    reply_channel: u64 = MakoAbi.channel_create(reply_name, 14);
    server: u64 = MakoAbi.channel_connect(service_name, 16);
    if reply_channel > 4294967295 or server > 4294967295 { return 130; }

    # A real X11 little-endian setup request: byte order 'l', version 11.0,
    # and no authorization payload, carried in one DemonX transport record.
    clear_packet(packet);
    set_header(packet, 12, 1, 1);
    vptr_write_u64(vptr_offset_u64(packet, 2), 721004);
    if MakoAbi.channel_send(server, packet_address, 64) != 64 { return 131; }
    if MakoAbi.channel_receive(reply_channel, packet_address, 64, 0) != 64 {
        return 132;
    }
    reply_header: u64 = vptr_read_u64(packet);
    reply_flags: u64 = reply_header / 281474976710656;
    reply_flags = reply_flags - (reply_flags / 65536) * 65536;
    if reply_flags != 2 { return 133; }

    # X_CreateWindow, 240x160 at (80,60), resource id 0x200001.
    clear_packet(packet);
    set_header(packet, 32, 0, 2);
    vptr_write_u64(vptr_offset_u64(packet, 2), pack_words(524289, 2097153));
    vptr_write_u64(vptr_offset_u64(packet, 3), pack_words(256, 3932240));
    vptr_write_u64(vptr_offset_u64(packet, 4), pack_words(10486000, 65536));
    if MakoAbi.channel_send(server, packet_address, 64) != 64 { return 134; }

    # X_SelectInput(StructureNotifyMask | KeyPressMask | KeyReleaseMask |
    # ButtonPressMask), followed by X_MapWindow. The map
    # now produces a genuine X11 MapNotify event rather than a fabricated
    # test-side state transition.
    clear_packet(packet);
    set_header(packet, 12, 0, 3);
    vptr_write_u64(vptr_offset_u64(packet, 2), pack_words(196651, 2097153));
    vptr_write_u64(vptr_offset_u64(packet, 3), 131079);
    if MakoAbi.channel_send(server, packet_address, 64) != 64 { return 135; }
    if send_request(server, packet_address, packet, 131080, 2097153, 3) != 64 {
        return 136;
    }
    if MakoAbi.channel_receive(reply_channel, packet_address, 64, 0) != 64 {
        return 137;
    }
    reply_header = vptr_read_u64(packet);
    reply_flags = reply_header / 281474976710656;
    reply_flags = reply_flags - (reply_flags / 65536) * 65536;
    event_word: u64 = vptr_read_u64(vptr_offset_u64(packet, 2));
    event_type: u64 = event_word - (event_word / 256) * 256;
    if reply_flags != 8 or event_type != 19 { return 138; }

    if send_request(server, packet_address, packet, 131086, 2097153, 5) != 64 {
        return 139;
    }
    if MakoAbi.channel_receive(reply_channel, packet_address, 64, 0) != 64 {
        return 140;
    }
    reply_header = vptr_read_u64(packet);
    reply_flags = reply_header / 281474976710656;
    reply_flags = reply_flags - (reply_flags / 65536) * 65536;
    geometry: u64 = vptr_read_u64(vptr_offset_u64(packet, 3));
    geometry_x: u64 = geometry - (geometry / 65536) * 65536;
    geometry_y: u64 = geometry / 65536;
    geometry_y = geometry_y - (geometry_y / 65536) * 65536;
    geometry_width: u64 = geometry / 4294967296;
    geometry_width = geometry_width - (geometry_width / 65536) * 65536;
    geometry_height: u64 = geometry / 281474976710656;
    if reply_flags != 2 {
        error_word: u64 = vptr_read_u64(vptr_offset_u64(packet, 2));
        error_code: u64 = error_word / 256;
        error_code = error_code - (error_code / 256) * 256;
        return 150 + error_code;
    }
    if geometry_x != 80 { return 144; }
    if geometry_y != 60 { return 145; }
    if geometry_width != 240 { return 146; }
    if geometry_height != 160 { return 147; }

    # CreateGC + PolyFillRectangle draw through a bounded GC into the real
    # kernel-backed surface. A synchronous geometry reply after the draw also
    # proves no deferred X error was queued by either graphics request.
    clear_packet(packet);
    set_header_for(packet, 20, 0, 1, 20);
    vptr_write_u64(vptr_offset_u64(packet, 2),
                   pack_words(327735, 2097154));
    vptr_write_u64(vptr_offset_u64(packet, 3),
                   pack_words(2097153, 4));
    vptr_write_u64(vptr_offset_u64(packet, 4), 3900150);
    if MakoAbi.channel_send(server, packet_address, 64) != 64 { return 212; }

    clear_packet(packet);
    set_header_for(packet, 20, 0, 1, 21);
    vptr_write_u64(vptr_offset_u64(packet, 2),
                   pack_words(327750, 2097153));
    vptr_write_u64(vptr_offset_u64(packet, 3),
                   pack_words(2097154, 524296));
    vptr_write_u64(vptr_offset_u64(packet, 4), 1572912);
    if MakoAbi.channel_send(server, packet_address, 64) != 64 { return 213; }

    # Seven rectangles form a 68-byte X11 request. The first wire record
    # carries 48 bytes with MORE set; the second carries the remaining 20.
    # This exercises bounded continuation/reassembly in the actual boot test.
    clear_packet(packet);
    set_header_for(packet, 48, 16, 1, 24);
    vptr_write_u64(vptr_offset_u64(packet, 2),
                   pack_words(1114182, 2097153));
    vptr_write_u64(vptr_offset_u64(packet, 3),
                   pack_words(2097154, 2621448));
    vptr_write_u64(vptr_offset_u64(packet, 4),
                   pack_words(786444, 2621448));
    vptr_write_u64(vptr_offset_u64(packet, 5),
                   pack_words(786444, 2621448));
    vptr_write_u64(vptr_offset_u64(packet, 6),
                   pack_words(786444, 2621448));
    vptr_write_u64(vptr_offset_u64(packet, 7),
                   pack_words(786444, 2621448));
    if MakoAbi.channel_send(server, packet_address, 64) != 64 { return 218; }

    clear_packet(packet);
    set_header_for(packet, 20, 0, 1, 24);
    vptr_write_u64(vptr_offset_u64(packet, 2),
                   pack_words(786444, 2621448));
    vptr_write_u64(vptr_offset_u64(packet, 3),
                   pack_words(786444, 2621448));
    vptr_write_u64(vptr_offset_u64(packet, 4), 786444);
    if MakoAbi.channel_send(server, packet_address, 64) != 64 { return 219; }

    # Bound the producer burst before starting the pixmap lifecycle.
    if send_request(server, packet_address, packet,
                    131086, 2097153, 30) != 64 { return 235; }
    if MakoAbi.channel_receive(reply_channel, packet_address, 64, 0) != 64 {
        return 236;
    }
    reply_header = vptr_read_u64(packet);
    reply_flags = reply_header / 281474976710656;
    reply_flags = reply_flags - (reply_flags / 65536) * 65536;
    if reply_flags != 2 { return 237; }

    # Create an 8x4 depth-32 pixmap, attach a GC, and upload four actual
    # pixels through PutImage. The synchronous request below catches errors
    # from the complete create/write/free resource lifecycle.
    clear_packet(packet);
    set_header_for(packet, 16, 0, 1, 25);
    vptr_write_u64(vptr_offset_u64(packet, 2),
                   pack_words(270389, 2097155));
    vptr_write_u64(vptr_offset_u64(packet, 3),
                   pack_words(2097153, 262152));
    if MakoAbi.channel_send(server, packet_address, 64) != 64 { return 230; }

    clear_packet(packet);
    set_header_for(packet, 20, 0, 1, 26);
    vptr_write_u64(vptr_offset_u64(packet, 2),
                   pack_words(327735, 2097156));
    vptr_write_u64(vptr_offset_u64(packet, 3),
                   pack_words(2097155, 4));
    vptr_write_u64(vptr_offset_u64(packet, 4), 10996545);
    if MakoAbi.channel_send(server, packet_address, 64) != 64 { return 231; }

    clear_packet(packet);
    set_header_for(packet, 40, 0, 1, 27);
    vptr_write_u64(vptr_offset_u64(packet, 2),
                   pack_words(655944, 2097155));
    vptr_write_u64(vptr_offset_u64(packet, 3),
                   pack_words(2097156, 65540));
    vptr_write_u64(vptr_offset_u64(packet, 4), pack_words(0, 8192));
    vptr_write_u64(vptr_offset_u64(packet, 5),
                   pack_words(4293870656, 4294281728));
    vptr_write_u64(vptr_offset_u64(packet, 6),
                   pack_words(4278233855, 4286578943));
    if MakoAbi.channel_send(server, packet_address, 64) != 64 { return 232; }

    # Copy the uploaded first row into the second row. This is a real
    # overlapping pixmap CopyArea and exercises the server's read-only
    # source mapping plus bounded, overlap-safe native-surface writeback.
    clear_packet(packet);
    set_header_for(packet, 28, 0, 1, 28);
    vptr_write_u64(vptr_offset_u64(packet, 2),
                   pack_words(458814, 2097155));
    vptr_write_u64(vptr_offset_u64(packet, 3),
                   pack_words(2097155, 2097156));
    vptr_write_u64(vptr_offset_u64(packet, 4), pack_words(0, 65536));
    vptr_write_u64(vptr_offset_u64(packet, 5), 65540);
    if MakoAbi.channel_send(server, packet_address, 64) != 64 { return 238; }

    # Install the pixmap as the window background and clear the window. This
    # verifies real tiled background rendering rather than attribute-only
    # protocol acceptance.
    clear_packet(packet);
    set_header_for(packet, 16, 0, 1, 29);
    vptr_write_u64(vptr_offset_u64(packet, 2),
                   pack_words(262146, 2097153));
    vptr_write_u64(vptr_offset_u64(packet, 3),
                   pack_words(1, 2097155));
    if MakoAbi.channel_send(server, packet_address, 64) != 64 { return 239; }

    clear_packet(packet);
    set_header_for(packet, 16, 0, 1, 30);
    vptr_write_u64(vptr_offset_u64(packet, 2),
                   pack_words(262205, 2097153));
    if MakoAbi.channel_send(server, packet_address, 64) != 64 { return 240; }

    # Render a core-font "A" into the pixmap with PolyText8.
    clear_packet(packet);
    set_header_for(packet, 20, 0, 1, 31);
    vptr_write_u64(vptr_offset_u64(packet, 2),
                   pack_words(327754, 2097155));
    vptr_write_u64(vptr_offset_u64(packet, 3),
                   pack_words(2097156, 458752));
    vptr_write_u64(vptr_offset_u64(packet, 4), 16641);
    if MakoAbi.channel_send(server, packet_address, 64) != 64 { return 244; }

    # Read four pixels back from the copied pixmap row. The 48-byte reply
    # fits one transport record and proves the server maps and returns actual
    # drawable storage.
    clear_packet(packet);
    set_header_for(packet, 20, 0, 1, 32);
    vptr_write_u64(vptr_offset_u64(packet, 2),
                   pack_words(328265, 2097155));
    vptr_write_u64(vptr_offset_u64(packet, 3),
                   pack_words(65536, 65540));
    vptr_write_u64(vptr_offset_u64(packet, 4), 4294967295);
    if MakoAbi.channel_send(server, packet_address, 64) != 64 { return 241; }
    if MakoAbi.channel_receive(reply_channel, packet_address, 64, 0) != 64 {
        return 242;
    }
    reply_header = vptr_read_u64(packet);
    reply_flags = reply_header / 281474976710656;
    reply_flags = reply_flags - (reply_flags / 65536) * 65536;
    if reply_flags != 2 {
        get_error_word: u64 = vptr_read_u64(vptr_offset_u64(packet, 2));
        get_error: u64 = get_error_word / 256;
        get_error = get_error - (get_error / 256) * 256;
        return 243 + get_error;
    }

    if send_request_for(server, packet, 131132, 2097156, 1, 33) != 64 {
        return 233;
    }
    if send_request_for(server, packet, 131126, 2097155, 1, 34) != 64 {
        return 234;
    }

    if send_request(server, packet_address, packet,
                    131086, 2097153, 22) != 64 { return 214; }
    if MakoAbi.channel_receive(reply_channel, packet_address, 64, 0) != 64 {
        return 215;
    }
    reply_header = vptr_read_u64(packet);
    reply_flags = reply_header / 281474976710656;
    reply_flags = reply_flags - (reply_flags / 65536) * 65536;
    if reply_flags != 2 {
        draw_error_word: u64 = vptr_read_u64(vptr_offset_u64(packet, 2));
        draw_error: u64 = draw_error_word / 256;
        draw_error = draw_error - (draw_error / 256) * 256;
        return 220 + draw_error;
    }

    if send_request(server, packet_address, packet,
                    131132, 2097154, 23) != 64 { return 217; }

    if send_request(server, packet_address, packet, 131076, 2097153, 6) != 64 {
        return 141;
    }
    if send_request(server, packet_address, packet, 131086, 2097153, 7) != 64 {
        return 142;
    }
    if MakoAbi.channel_receive(reply_channel, packet_address, 64, 0) != 64 {
        return 143;
    }
    reply_header = vptr_read_u64(packet);
    reply_flags = reply_header / 281474976710656;
    reply_flags = reply_flags - (reply_flags / 65536) * 65536;
    if reply_flags != 4 { return 144; }

    # Client 1 now becomes the window manager by selecting redirect events on
    # the synthetic root. Client 2 connects independently, creates a window,
    # and its map is delivered to client 1 as MapRequest. Once client 1 maps
    # that window, client 2 receives MapNotify on its own reply channel.
    clear_packet(packet);
    set_header_for(packet, 12, 0, 1, 8);
    vptr_write_u64(vptr_offset_u64(packet, 2), pack_words(196651, 256));
    vptr_write_u64(vptr_offset_u64(packet, 3), 5767168);
    if MakoAbi.channel_send(server, packet_address, 64) != 64 { return 168; }

    reply_channel2: u64 = MakoAbi.channel_create(reply_name2, 14);
    if reply_channel2 > 4294967295 { return 169; }
    clear_packet(packet);
    set_header_for(packet, 12, 1, 2, 1);
    vptr_write_u64(vptr_offset_u64(packet, 2), 721004);
    if MakoAbi.channel_send(server, packet_address, 64) != 64 { return 170; }
    if MakoAbi.channel_receive(reply_channel2, packet_address, 64, 0) != 64 {
        return 171;
    }
    reply_header = vptr_read_u64(packet);
    reply_flags = reply_header / 281474976710656;
    reply_flags = reply_flags - (reply_flags / 65536) * 65536;
    resource_word: u64 = vptr_read_u64(vptr_offset_u64(packet, 3));
    resource_base: u64 = resource_word / 4294967296;
    if reply_flags != 2 or resource_base != 4194304 { return 172; }

    clear_packet(packet);
    set_header_for(packet, 32, 0, 2, 2);
    vptr_write_u64(vptr_offset_u64(packet, 2), pack_words(524289, 4194305));
    vptr_write_u64(vptr_offset_u64(packet, 3), pack_words(256, 3932240));
    vptr_write_u64(vptr_offset_u64(packet, 4), pack_words(10486000, 65536));
    if MakoAbi.channel_send(server, packet_address, 64) != 64 { return 173; }
    clear_packet(packet);
    set_header_for(packet, 12, 0, 2, 3);
    vptr_write_u64(vptr_offset_u64(packet, 2), pack_words(196651, 4194305));
    vptr_write_u64(vptr_offset_u64(packet, 3), 131072);
    if MakoAbi.channel_send(server, packet_address, 64) != 64 { return 174; }
    if send_request_for(server, packet,
                        131080, 4194305, 2, 4) != 64 { return 175; }
    if MakoAbi.channel_receive(reply_channel, packet_address, 64, 0) != 64 {
        return 176;
    }
    reply_header = vptr_read_u64(packet);
    reply_flags = reply_header / 281474976710656;
    reply_flags = reply_flags - (reply_flags / 65536) * 65536;
    event_word = vptr_read_u64(vptr_offset_u64(packet, 2));
    event_type = event_word - (event_word / 256) * 256;
    if reply_flags != 8 or event_type != 20 { return 177; }

    if send_request_for(server, packet,
                        131080, 4194305, 1, 9) != 64 { return 178; }
    if MakoAbi.channel_receive(reply_channel2, packet_address, 64, 0) != 64 {
        return 179;
    }
    reply_header = vptr_read_u64(packet);
    reply_flags = reply_header / 281474976710656;
    reply_flags = reply_flags - (reply_flags / 65536) * 65536;
    event_word = vptr_read_u64(vptr_offset_u64(packet, 2));
    event_type = event_word - (event_word / 256) * 256;
    if reply_flags != 8 or event_type != 19 { return 180; }

    # Client 2 asks for new geometry. Redirect prevents the change and sends
    # ConfigureRequest to the WM; client 1 then applies the exact request and
    # client 2 receives ConfigureNotify.
    clear_packet(packet);
    set_header_for(packet, 28, 0, 2, 5);
    vptr_write_u64(vptr_offset_u64(packet, 2), pack_words(458764, 4194305));
    vptr_write_u64(vptr_offset_u64(packet, 3), pack_words(15, 100));
    vptr_write_u64(vptr_offset_u64(packet, 4), pack_words(70, 260));
    vptr_write_u64(vptr_offset_u64(packet, 5), 170);
    if MakoAbi.channel_send(server, packet_address, 64) != 64 { return 181; }
    if MakoAbi.channel_receive(reply_channel, packet_address, 64, 0) != 64 {
        return 182;
    }
    reply_header = vptr_read_u64(packet);
    reply_flags = reply_header / 281474976710656;
    reply_flags = reply_flags - (reply_flags / 65536) * 65536;
    event_word = vptr_read_u64(vptr_offset_u64(packet, 2));
    event_type = event_word - (event_word / 256) * 256;
    if reply_flags != 8 or event_type != 23 { return 183; }

    clear_packet(packet);
    set_header_for(packet, 28, 0, 1, 10);
    vptr_write_u64(vptr_offset_u64(packet, 2), pack_words(458764, 4194305));
    vptr_write_u64(vptr_offset_u64(packet, 3), pack_words(15, 100));
    vptr_write_u64(vptr_offset_u64(packet, 4), pack_words(70, 260));
    vptr_write_u64(vptr_offset_u64(packet, 5), 170);
    if MakoAbi.channel_send(server, packet_address, 64) != 64 { return 184; }
    if MakoAbi.channel_receive(reply_channel2, packet_address, 64, 0) != 64 {
        return 185;
    }
    reply_header = vptr_read_u64(packet);
    reply_flags = reply_header / 281474976710656;
    reply_flags = reply_flags - (reply_flags / 65536) * 65536;
    event_word = vptr_read_u64(vptr_offset_u64(packet, 2));
    event_type = event_word - (event_word / 256) * 256;
    if reply_flags != 8 or event_type != 22 { return 186; }

    # QueryTree proves the server's parent/child state is authoritative.
    if send_request_for(server, packet, 131087, 256, 1, 11) != 64 {
        return 187;
    }
    if MakoAbi.channel_receive(reply_channel, packet_address, 64, 0) != 64 {
        return 188;
    }
    reply_header = vptr_read_u64(packet);
    reply_flags = reply_header / 281474976710656;
    reply_flags = reply_flags - (reply_flags / 65536) * 65536;
    tree_word: u64 = vptr_read_u64(vptr_offset_u64(packet, 4));
    tree_children: u64 = tree_word - (tree_word / 65536) * 65536;
    tree_child: u64 = vptr_read_u64(vptr_offset_u64(packet, 6));
    tree_child = tree_child - (tree_child / 4294967296) * 4294967296;
    if reply_flags != 2 or tree_children != 1 or tree_child != 4194305 {
        return 189;
    }

    # UnmapNotify is delivered to the WM through the root's
    # SubstructureNotifyMask selection.
    if send_request_for(server, packet, 131082, 4194305, 2, 6) != 64 {
        return 190;
    }
    if MakoAbi.channel_receive(reply_channel, packet_address, 64, 0) != 64 {
        return 191;
    }
    reply_header = vptr_read_u64(packet);
    reply_flags = reply_header / 281474976710656;
    reply_flags = reply_flags - (reply_flags / 65536) * 65536;
    event_word = vptr_read_u64(vptr_offset_u64(packet, 2));
    event_type = event_word - (event_word / 256) * 256;
    if reply_flags != 8 or event_type != 18 { return 192; }

    # ICCCM/EWMH foundation: intern a real atom, attach a STRING property to
    # the root, retrieve and enumerate it, then delete it. These are the same
    # server-side objects a window manager uses for names and protocol hints.
    clear_packet(packet);
    set_header_for(packet, 16, 0, 1, 12);
    vptr_write_u64(vptr_offset_u64(packet, 2), pack_words(262160, 5));
    vptr_write_u64(vptr_offset_u64(packet, 3), 336337913156);
    if MakoAbi.channel_send(server, packet_address, 64) != 64 { return 194; }
    if MakoAbi.channel_receive(reply_channel, packet_address, 64, 0) != 64 {
        return 195;
    }
    reply_header = vptr_read_u64(packet);
    reply_flags = reply_header / 281474976710656;
    reply_flags = reply_flags - (reply_flags / 65536) * 65536;
    atom_word: u64 = vptr_read_u64(vptr_offset_u64(packet, 3));
    atom: u64 = atom_word - (atom_word / 4294967296) * 4294967296;
    if reply_flags != 2 or atom != 4096 { return 196; }

    clear_packet(packet);
    set_header_for(packet, 28, 0, 1, 13);
    vptr_write_u64(vptr_offset_u64(packet, 2), pack_words(458770, 256));
    vptr_write_u64(vptr_offset_u64(packet, 3), pack_words(atom, 31));
    vptr_write_u64(vptr_offset_u64(packet, 4), pack_words(8, 4));
    vptr_write_u64(vptr_offset_u64(packet, 5), 1464550736);
    if MakoAbi.channel_send(server, packet_address, 64) != 64 { return 197; }
    if MakoAbi.channel_receive(reply_channel, packet_address, 64, 0) != 64 {
        return 198;
    }
    reply_header = vptr_read_u64(packet);
    reply_flags = reply_header / 281474976710656;
    reply_flags = reply_flags - (reply_flags / 65536) * 65536;
    event_word = vptr_read_u64(vptr_offset_u64(packet, 2));
    event_type = event_word - (event_word / 256) * 256;
    property_event_atom: u64 = vptr_read_u64(vptr_offset_u64(packet, 3));
    property_event_atom =
        property_event_atom - (property_event_atom / 4294967296) * 4294967296;
    if reply_flags != 8 or event_type != 28 or
       property_event_atom != atom { return 199; }

    clear_packet(packet);
    set_header_for(packet, 24, 0, 1, 14);
    vptr_write_u64(vptr_offset_u64(packet, 2), pack_words(393236, 256));
    vptr_write_u64(vptr_offset_u64(packet, 3), atom);
    vptr_write_u64(vptr_offset_u64(packet, 4), pack_words(0, 6));
    if MakoAbi.channel_send(server, packet_address, 64) != 64 { return 200; }
    if MakoAbi.channel_receive(reply_channel, packet_address, 64, 0) != 64 {
        return 201;
    }
    reply_header = vptr_read_u64(packet);
    reply_flags = reply_header / 281474976710656;
    reply_flags = reply_flags - (reply_flags / 65536) * 65536;
    property_word: u64 = vptr_read_u64(vptr_offset_u64(packet, 3));
    property_type: u64 =
        property_word - (property_word / 4294967296) * 4294967296;
    item_word: u64 = vptr_read_u64(vptr_offset_u64(packet, 4));
    item_count: u64 =
        item_word - (item_word / 4294967296) * 4294967296;
    property_data: u64 = vptr_read_u64(vptr_offset_u64(packet, 6));
    property_data =
        property_data - (property_data / 4294967296) * 4294967296;
    if reply_flags != 2 or property_type != 31 or
       item_count != 4 or property_data != 1464550736 {
        return 202;
    }

    if send_request_for(server, packet, 131093, 256, 1, 15) != 64 {
        return 203;
    }
    if MakoAbi.channel_receive(reply_channel, packet_address, 64, 0) != 64 {
        return 204;
    }
    reply_header = vptr_read_u64(packet);
    reply_flags = reply_header / 281474976710656;
    reply_flags = reply_flags - (reply_flags / 65536) * 65536;
    property_count_word: u64 = vptr_read_u64(vptr_offset_u64(packet, 3));
    property_count: u64 =
        property_count_word - (property_count_word / 65536) * 65536;
    listed_atom: u64 = vptr_read_u64(vptr_offset_u64(packet, 6));
    listed_atom = listed_atom - (listed_atom / 4294967296) * 4294967296;
    if reply_flags != 2 or property_count != 1 or listed_atom != atom {
        return 205;
    }

    clear_packet(packet);
    set_header_for(packet, 12, 0, 1, 16);
    vptr_write_u64(vptr_offset_u64(packet, 2), pack_words(196627, 256));
    vptr_write_u64(vptr_offset_u64(packet, 3), atom);
    if MakoAbi.channel_send(server, packet_address, 64) != 64 { return 206; }
    if MakoAbi.channel_receive(reply_channel, packet_address, 64, 0) != 64 {
        return 207;
    }
    reply_header = vptr_read_u64(packet);
    reply_flags = reply_header / 281474976710656;
    reply_flags = reply_flags - (reply_flags / 65536) * 65536;
    event_word = vptr_read_u64(vptr_offset_u64(packet, 2));
    event_type = event_word - (event_word / 256) * 256;
    property_state_word: u64 =
        vptr_read_u64(vptr_offset_u64(packet, 4));
    property_state: u64 =
        property_state_word - (property_state_word / 256) * 256;
    if reply_flags != 8 or event_type != 28 or property_state != 1 {
        return 208;
    }

    # A synthetic ClientMessage follows the same route PekWM uses for
    # WM_PROTOCOLS/WM_DELETE_WINDOW: the WM sends it to the owning client and
    # the server marks it as a SendEvent-generated event.
    clear_packet(packet);
    set_header_for(packet, 44, 0, 1, 17);
    vptr_write_u64(vptr_offset_u64(packet, 2),
                   pack_words(720921, 4194305));
    vptr_write_u64(vptr_offset_u64(packet, 3), 35326106009600);
    vptr_write_u64(vptr_offset_u64(packet, 4),
                   pack_words(4194305, atom));
    vptr_write_u64(vptr_offset_u64(packet, 5), atom);
    if MakoAbi.channel_send(server, packet_address, 64) != 64 { return 209; }
    if MakoAbi.channel_receive(reply_channel2, packet_address, 64, 0) != 64 {
        return 210;
    }
    reply_header = vptr_read_u64(packet);
    reply_flags = reply_header / 281474976710656;
    reply_flags = reply_flags - (reply_flags / 65536) * 65536;
    event_word = vptr_read_u64(vptr_offset_u64(packet, 2));
    event_type = event_word - (event_word / 256) * 256;
    sent_bit: u64 = (event_word / 128) - (event_word / 256) * 2;
    client_window: u64 = event_word / 4294967296;
    client_data_word: u64 = vptr_read_u64(vptr_offset_u64(packet, 3));
    client_data: u64 = client_data_word / 4294967296;
    if reply_flags != 8 or event_type != 161 or sent_bit != 1 or
       client_window != 4194305 or client_data != atom {
        return 211;
    }

    if send_request_for(server, packet,
                        131076, 4194305, 1, 18) != 64 { return 193; }

    MakoAbi.handle_close(server);
    MakoAbi.handle_close(reply_channel);
    MakoAbi.handle_close(reply_channel2);
    MakoAbi.exit(0);
    return 0;
}
