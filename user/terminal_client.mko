use "sdk.mko";

fn low32(value: u64) -> u64 {
    return value - (value / 4294967296) * 4294967296;
}

# Same masking trick as low32, sized for shorter/longer exact-length command
# names ("pid" needs 3 bytes, "uptime"/"whoami" need 6) read out of the same
# single 8-byte word the length-4/5 checks already use.
fn low24(value: u64) -> u64 {
    return value - (value / 16777216) * 16777216;
}

fn low48(value: u64) -> u64 {
    return value - (value / 281474976710656) * 281474976710656;
}

# Writes value as decimal ASCII starting at output_address+start, returns the
# position just past the last digit (the new output_length). Used by uptime
# and pid, which print live syscall results instead of a canned string.
fn write_decimal(output_address: u64, start: u64, value: u64) -> u64 {
    if value == 0 {
        put_byte(output_address, start, 48);
        return start + 1;
    }
    digit_count: u64 = 0;
    probe: u64 = value;
    while probe > 0 { digit_count = digit_count + 1; probe = probe / 10; }
    divisor: u64 = 1;
    index: u64 = 1;
    while index < digit_count { divisor = divisor * 10; index = index + 1; }
    position: u64 = start;
    remaining: u64 = value;
    while divisor > 0 {
        digit: u64 = remaining / divisor;
        put_byte(output_address, position, 48 + digit);
        remaining = remaining - digit * divisor;
        position = position + 1;
        divisor = divisor / 10;
    }
    return position;
}

fn write_event_name(name: vptr<u8>, pid: u64) -> u64 {
    vptr_write_u8(name, 100); vptr_write_u8(vptr_offset_u8(name, 1), 101);
    vptr_write_u8(vptr_offset_u8(name, 2), 115); vptr_write_u8(vptr_offset_u8(name, 3), 107);
    vptr_write_u8(vptr_offset_u8(name, 4), 116); vptr_write_u8(vptr_offset_u8(name, 5), 111);
    vptr_write_u8(vptr_offset_u8(name, 6), 112); vptr_write_u8(vptr_offset_u8(name, 7), 46);
    vptr_write_u8(vptr_offset_u8(name, 8), 119); vptr_write_u8(vptr_offset_u8(name, 9), 105);
    vptr_write_u8(vptr_offset_u8(name, 10), 110);
    vptr_write_u8(vptr_offset_u8(name, 11), 48 + pid - (pid / 10) * 10);
    return 0;
}

fn glyph_mask(character: u64) -> u64 {
    if character == 48 { return 15623448110; } if character == 49 { return 15170932932; }
    if character == 50 { return 33357578798; } if character == 51 { return 16660251151; }
    if character == 52 { return 8891181448; } if character == 53 { return 16660268095; }
    if character == 54 { return 15621129262; } if character == 55 { return 2216829471; }
    if character == 56 { return 15621113390; } if character == 57 { return 15587034670; }
    if character == 97 { return 18842895918; } if character == 98 { return 16694887983; }
    if character == 99 { return 32246891582; } if character == 100 { return 16694953519; }
    if character == 101 { return 33321092159; } if character == 102 { return 1108837439; }
    if character == 103 { return 32801457214; } if character == 104 { return 18842895921; }
    if character == 105 { return 15170932878; } if character == 106 { return 15621177872; }
    if character == 107 { return 18560947505; } if character == 108 { return 33320633377; }
    if character == 109 { return 18842572657; } if character == 110 { return 18842703473; }
    if character == 111 { return 15621211694; } if character == 112 { return 1108854319; }
    if character == 113 { return 23946905134; } if character == 114 { return 18561353263; }
    if character == 115 { return 16660235326; } if character == 116 { return 4433514655; }
    if character == 117 { return 15621211697; } if character == 118 { return 4648912433; }
    if character == 119 { return 11464787505; } if character == 120 { return 18834663985; }
    if character == 121 { return 4433521201; } if character == 122 { return 33321787935; }
    if character == 62 { return 1118273; } if character == 36 { return 4819720132; }
    if character == 45 { return 1015808; } if character == 46 { return 13287555072; }
    return 0;
}

fn set_pixel(pixels: vptr<u64>, offset: u64, color: u64, strip_y: u64) -> u64 {
    pixel_y: u64 = offset / 256;
    if pixel_y < strip_y or pixel_y >= strip_y + 16 { return 0; }
    local_offset: u64 = offset - strip_y * 256;
    word_offset: u64 = local_offset / 2;
    word: u64 = vptr_read_u64(vptr_offset_u64(pixels, word_offset));
    odd: u64 = local_offset - word_offset * 2;
    if odd == 0 { word = color + (word / 4294967296) * 4294967296; }
    else { word = low32(word) + color * 4294967296; }
    vptr_write_u64(vptr_offset_u64(pixels, word_offset), word);
    return 0;
}

fn clear_bytes(address: u64, count: u64) -> u64 {
    bytes: vptr<u8> = vptr_from_u8(address);
    index: u64 = 0;
    while index < count {
        vptr_write_u8(vptr_offset_u8(bytes, index), 0);
        index = index + 1;
    }
    return 0;
}

fn put_byte(address: u64, offset: u64, value: u64) -> u64 {
    vptr_write_u8(vptr_offset_u8(vptr_from_u8(address), offset), value);
    return 0;
}

fn get_byte(address: u64, offset: u64) -> u64 {
    word_index: u64 = offset / 8;
    byte_index: u64 = offset - word_index * 8;
    divisor: u64 = 1;
    while byte_index > 0 { divisor = divisor * 256; byte_index = byte_index - 1; }
    value: u64 = vptr_read_u64(vptr_offset_u64(vptr_from_u64(address), word_index));
    value = value / divisor;
    return value - (value / 256) * 256;
}

fn draw_character(pixels: vptr<u64>, x: u64, y: u64,
                  character: u64, color: u64, strip_y: u64) -> u64 {
    mask: u64 = glyph_mask(character);
    index: u64 = 0;
    divisor: u64 = 1;
    while index < 35 {
        bit: u64 = mask / divisor;
        bit = bit - (bit / 2) * 2;
        if bit == 1 {
            row: u64 = index / 5;
            column: u64 = index - row * 5;
            set_pixel(pixels, x + column + (y + row) * 256, color, strip_y);
        }
        divisor = divisor * 2;
        index = index + 1;
    }
    return 0;
}

fn draw_prompt(pixels: vptr<u64>, y: u64, text_address: u64,
               text_length: u64, cursor: u64, strip_y: u64) -> u64 {
    draw_character(pixels, 4, y, 100, 4280468830, strip_y);
    draw_character(pixels, 10, y, 101, 4280468830, strip_y);
    draw_character(pixels, 16, y, 109, 4280468830, strip_y);
    draw_character(pixels, 22, y, 111, 4280468830, strip_y);
    draw_character(pixels, 28, y, 110, 4280468830, strip_y);
    draw_character(pixels, 40, y, 36, 4280468830, strip_y);
    # Wrap like a full terminal grid. The prompt leaves room for 33 characters
    # on its first row; continuation rows span 41 characters. If the line is
    # longer than the available rows, retain a rolling tail instead of
    # refusing input or hiding everything behind a one-line viewport.
    row_count: u64 = (57 - y) / 8 + 1;
    visible_capacity: u64 = 32;
    if row_count > 1 { visible_capacity = 32 + (row_count - 1) * 41; }
    visible_start: u64 = 0;
    visible_length: u64 = text_length;
    if visible_length > visible_capacity {
        visible_start = visible_length - visible_capacity;
        visible_length = visible_capacity;
    }
    position: u64 = 0;
    while position < visible_length {
        character_x: u64 = 52 + position * 6;
        character_y: u64 = y;
        if position >= 33 {
            continuation: u64 = position - 33;
            character_x = 4 + (continuation - (continuation / 41) * 41) * 6;
            character_y = y + 8 + (continuation / 41) * 8;
        }
        draw_character(pixels, character_x, character_y,
                       get_byte(text_address, visible_start + position),
                       4293257195, strip_y);
        position = position + 1;
    }
    if cursor == 1 {
        cursor_x: u64 = 52 + visible_length * 6;
        cursor_y: u64 = y;
        if visible_length >= 33 {
            cursor_continuation: u64 = visible_length - 33;
            cursor_x = 4 + (cursor_continuation -
                       (cursor_continuation / 41) * 41) * 6;
            cursor_y = y + 8 + (cursor_continuation / 41) * 8;
        }
        cursor_row: u64 = 0;
        while cursor_row < 7 {
            set_pixel(pixels, cursor_x + (cursor_y + cursor_row) * 128,
                      4285377000, strip_y);
            cursor_row = cursor_row + 1;
        }
    }
    return 0;
}

fn redraw(surface: u64, pixel_address: u64,
          text_address: u64, text_length: u64,
          history_length: u64, output_length: u64) -> u64 {
    pixels: vptr<u64> = vptr_from_u64(pixel_address);
    history_address: u64 = text_address + 1536;
    output_address: u64 = history_address + 1536;
    background: u64 = 4278915616;
    packed: u64 = background + background * 4294967296;
    strip: u64 = 0;
    while strip < 4 {
    strip_y: u64 = strip * 16;
    word: u64 = 0;
    while word < 2048 { vptr_write_u64(vptr_offset_u64(pixels, word), packed); word = word + 1; }
    prompt_y: u64 = 3;
    if history_length > 0 {
        draw_prompt(pixels, 3, history_address, history_length, 0, strip_y);
        prompt_y = 52;
    }
    draw_prompt(pixels, prompt_y, text_address, text_length, 1, strip_y);
    output_position: u64 = 0;
    output_x: u64 = 4;
    output_y: u64 = 14;
    while output_position < output_length {
        output_character: u64 = get_byte(output_address, output_position);
        if output_character == 10 {
            output_x = 4;
            output_y = output_y + 9;
        } else {
            draw_character(pixels, output_x, output_y, output_character,
                           4284524026, strip_y);
            output_x = output_x + 6;
        }
        output_position = output_position + 1;
    }
    if MakoAbi.surface_write(surface, pixel_address, 4096, strip * 4096) != 4096 { return 1; }
    strip = strip + 1;
    }
    if MakoAbi.surface_damage(surface, 0, 0, 256, 64) != 0 { return 1; }
    return 0;
}

fn terminal_client_main(compositor_name: u64) -> u64 {
    packet_address: u64 = 3309568;
    pixel_address: u64 = packet_address + 128;
    name_address: u64 = pixel_address + 16384;
    text_address: u64 = name_address + 16;
    history_address: u64 = text_address + 1536;
    output_address: u64 = history_address + 1536;
    # Window identifiers are compositor protocol identities, not scheduler
    # PIDs. IDs 4-6 are consumed by the deterministic boot contract, so the
    # persistent desktop terminal owns the next stable endpoint.
    window_id: u64 = 7;
    write_event_name(vptr_from_u8(name_address), window_id);
    event_server: u64 = MakoAbi.channel_create(name_address, 12);
    compositor: u64 = MakoAbi.channel_connect(compositor_name, 18);
    factory: u64 = MakoAbi.service_open(9);
    surface: u64 = MakoAbi.surface_create(factory, 256, 64);
    if surface > 4294967295 { MakoAbi.exit(120); return 120; }
    clear_bytes(text_address, 1536);
    clear_bytes(history_address, 1536);
    clear_bytes(output_address, 64);
    if redraw(surface, pixel_address, text_address, 0, 0, 0) != 0 {
        MakoAbi.exit(121); return 121;
    }
    shared_surface: u64 = MakoAbi.surface_share(surface, compositor);
    packet: vptr<u64> = vptr_from_u64(packet_address);
    word: u64 = 0;
    while word < 8 { vptr_write_u64(vptr_offset_u64(packet, word), 0); word = word + 1; }
    vptr_write_u64(packet, 131073 + 4294967296);
    vptr_write_u64(vptr_offset_u64(packet, 1), window_id);
    vptr_write_u64(vptr_offset_u64(packet, 2), 72 + 96 * 4294967296);
    # Match the normal desktop window after its standard retained MOVE geometry
    # (320x240), not the smaller transient CREATE geometry. The compositor extends the
    # terminal background across the full client area while preserving the
    # compact 160x80 text grid at the top-left.
    vptr_write_u64(vptr_offset_u64(packet, 3), 320 + 240 * 4294967296);
    vptr_write_u64(vptr_offset_u64(packet, 4), shared_surface);
    if MakoAbi.channel_send(compositor, packet_address, 64) != 64 {
        MakoAbi.exit(122); return 122;
    }
    MakoAbi.handle_close(compositor);
    MakoAbi.handle_close(factory);
    text_length: u64 = 0;
    history_length: u64 = 0;
    output_length: u64 = 0;
    text: vptr<u8> = vptr_from_u8(text_address);
    while true {
        if MakoAbi.channel_receive(event_server, packet_address, 64, 0) != 64 {
            MakoAbi.exit(123); return 123;
        }
        key_word: u64 = vptr_read_u64(vptr_offset_u64(packet, 2));
        event_type: u64 = key_word - (key_word / 65536) * 65536;
        character: u64 = low32(vptr_read_u64(vptr_offset_u64(packet, 3)));
        if event_type == 1 {
            if character == 8 {
                if text_length > 0 { text_length = text_length - 1; }
            } else if character == 10 {
                input_word: u64 = vptr_read_u64(vptr_from_u64(text_address));
                input_low32: u64 = low32(input_word);
                input_low40: u64 = input_word -
                    (input_word / 1099511627776) * 1099511627776;
                clear_bytes(history_address, 1536);
                copy_index: u64 = 0;
                while copy_index < text_length {
                    put_byte(history_address, copy_index,
                             get_byte(text_address, copy_index));
                    copy_index = copy_index + 1;
                }
                history_length = text_length;
                clear_bytes(output_address, 64);
                # Default: "not found\ntry help".
                put_byte(output_address, 0, 110); put_byte(output_address, 1, 111);
                put_byte(output_address, 2, 116); put_byte(output_address, 3, 32);
                put_byte(output_address, 4, 102); put_byte(output_address, 5, 111);
                put_byte(output_address, 6, 117); put_byte(output_address, 7, 110);
                put_byte(output_address, 8, 100); put_byte(output_address, 9, 10);
                put_byte(output_address, 10, 116); put_byte(output_address, 11, 114);
                put_byte(output_address, 12, 121); put_byte(output_address, 13, 32);
                put_byte(output_address, 14, 104); put_byte(output_address, 15, 101);
                put_byte(output_address, 16, 108); put_byte(output_address, 17, 112);
                output_length = 18;
                if text_length == 4 and input_low32 == 1886152040 {
                    # help -> "commands\nhelp echo uptime\npid whoami clear fetch"
                    clear_bytes(output_address, 64);
                    put_byte(output_address, 0, 99);
                    put_byte(output_address, 1, 111);
                    put_byte(output_address, 2, 109);
                    put_byte(output_address, 3, 109);
                    put_byte(output_address, 4, 97);
                    put_byte(output_address, 5, 110);
                    put_byte(output_address, 6, 100);
                    put_byte(output_address, 7, 115);
                    put_byte(output_address, 8, 10);
                    put_byte(output_address, 9, 104);
                    put_byte(output_address, 10, 101);
                    put_byte(output_address, 11, 108);
                    put_byte(output_address, 12, 112);
                    put_byte(output_address, 13, 32);
                    put_byte(output_address, 14, 101);
                    put_byte(output_address, 15, 99);
                    put_byte(output_address, 16, 104);
                    put_byte(output_address, 17, 111);
                    put_byte(output_address, 18, 32);
                    put_byte(output_address, 19, 117);
                    put_byte(output_address, 20, 112);
                    put_byte(output_address, 21, 116);
                    put_byte(output_address, 22, 105);
                    put_byte(output_address, 23, 109);
                    put_byte(output_address, 24, 101);
                    put_byte(output_address, 25, 10);
                    put_byte(output_address, 26, 112);
                    put_byte(output_address, 27, 105);
                    put_byte(output_address, 28, 100);
                    put_byte(output_address, 29, 32);
                    put_byte(output_address, 30, 119);
                    put_byte(output_address, 31, 104);
                    put_byte(output_address, 32, 111);
                    put_byte(output_address, 33, 97);
                    put_byte(output_address, 34, 109);
                    put_byte(output_address, 35, 105);
                    put_byte(output_address, 36, 32);
                    put_byte(output_address, 37, 99);
                    put_byte(output_address, 38, 108);
                    put_byte(output_address, 39, 101);
                    put_byte(output_address, 40, 97);
                    put_byte(output_address, 41, 114);
                    put_byte(output_address, 42, 32);
                    put_byte(output_address, 43, 102);
                    put_byte(output_address, 44, 101);
                    put_byte(output_address, 45, 116);
                    put_byte(output_address, 46, 99);
                    put_byte(output_address, 47, 104);
                    output_length = 48;
                } else if text_length == 5 and input_low40 == 448345171302 {
                    # fetch -> concise system identity that fits three rows.
                    clear_bytes(output_address, 64);
                    put_byte(output_address, 0, 100); put_byte(output_address, 1, 101);
                    put_byte(output_address, 2, 109); put_byte(output_address, 3, 111);
                    put_byte(output_address, 4, 110); put_byte(output_address, 5, 111);
                    put_byte(output_address, 6, 115); put_byte(output_address, 7, 10);
                    put_byte(output_address, 8, 107); put_byte(output_address, 9, 101);
                    put_byte(output_address, 10, 114); put_byte(output_address, 11, 110);
                    put_byte(output_address, 12, 101); put_byte(output_address, 13, 108);
                    put_byte(output_address, 14, 32); put_byte(output_address, 15, 48);
                    put_byte(output_address, 16, 46); put_byte(output_address, 17, 49);
                    put_byte(output_address, 18, 10);
                    put_byte(output_address, 19, 120); put_byte(output_address, 20, 56);
                    put_byte(output_address, 21, 54); put_byte(output_address, 22, 32);
                    put_byte(output_address, 23, 54); put_byte(output_address, 24, 52);
                    output_length = 25;
                } else if text_length == 5 and input_low40 == 491260308579 {
                    # clear
                    output_length = 0;
                    history_length = 0;
                    clear_bytes(history_address, 1536);
                } else if text_length >= 5 and input_low40 == 139308065637 {
                    # echo <text> -> print back whatever follows "echo ",
                    # clamped to the 64-byte output buffer.
                    clear_bytes(output_address, 64);
                    argument_length: u64 = text_length - 5;
                    if argument_length > 63 { argument_length = 63; }
                    echo_index: u64 = 0;
                    while echo_index < argument_length {
                        put_byte(output_address, echo_index,
                                 get_byte(text_address, 5 + echo_index));
                        echo_index = echo_index + 1;
                    }
                    output_length = argument_length;
                } else if text_length == 6 and low48(input_word) == 111520595079285 {
                    # uptime -> scheduler ticks since boot, live syscall value.
                    clear_bytes(output_address, 64);
                    output_length = write_decimal(output_address, 0, MakoAbi.ticks());
                } else if text_length == 3 and low24(input_word) == 6580592 {
                    # pid -> this process's own scheduler PID, live syscall value.
                    clear_bytes(output_address, 64);
                    output_length = write_decimal(output_address, 0, MakoAbi.getpid());
                } else if text_length == 6 and low48(input_word) == 115918507042935 {
                    # whoami
                    clear_bytes(output_address, 64);
                    put_byte(output_address, 0, 114);
                    put_byte(output_address, 1, 111);
                    put_byte(output_address, 2, 111);
                    put_byte(output_address, 3, 116);
                    output_length = 4;
                }
                clear_bytes(text_address, 1536);
                text_length = 0;
            } else if character >= 32 and text_length < 1536 {
                if character >= 65 and character <= 90 { character = character + 32; }
                vptr_write_u8(vptr_offset_u8(text, text_length), character);
                text_length = text_length + 1;
            }
            if redraw(surface, pixel_address, text_address, text_length,
                      history_length, output_length) != 0 {
                MakoAbi.exit(124); return 124;
            }
        }
    }
    return 0;
}
