namespace MakoWire;

use "sdk.mko";
use "mako_std.mko";

# U1 of docs/mako-userspace-improvements.md, Finding 2: every client that
# talks to the compositor over its 64-byte packet protocol (window
# create/move/crash-test clients) repeats the identical "zero 8 words, then
# write a packed version/opcode/serial header word" boilerplate -- the
# zero-fill loop appears byte-for-byte identical in seven separate files.
# One shared pair here instead of N hand-copied ones.

fn zero_packet(packet_address: u64) -> u64 {
    packet: vptr<u64> = vptr_from_u64(packet_address);
    word: u64 = 0;
    while word < 8 {
        vptr_write_u64(vptr_offset_u64(packet, word), 0);
        word = word + 1;
    }
    return 0;
}

# version/opcode packed into the low 32 bits (version | opcode << 16),
# serial in the high 32 bits -- matches every existing compositor
# wire-format header write byte-for-byte, e.g. "version 1, CREATE opcode 2,
# serial 1" (previously the magic literal `131073 + 4294967296`) is now
# `MakoWire.header(packet_address, 1, 2, 1)`.
fn header(packet_address: u64, version: u64, opcode: u64, serial: u64) -> u64 {
    packet: vptr<u64> = vptr_from_u64(packet_address);
    vptr_write_u64(packet, MakoStd.pack32(version + opcode * 65536, serial));
    return 0;
}
