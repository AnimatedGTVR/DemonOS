#ifndef DEMON_FREESTANDING_VECTOR
#define DEMON_FREESTANDING_VECTOR

// Minimal freestanding std::vector<T>, built for the EDE port's C++
// runtime (see include/demon/cxx_runtime.h): real libstdc++'s <vector>
// pulls in __cxa_throw, allocator_traits, and other pieces that don't
// exist under -ffreestanding -fno-exceptions -nostdlib. This is a real
// implementation of the subset of the interface EDE-vintage FLTK-adjacent
// code actually uses (push_back/size/operator[]/iteration/resize), not a
// stub -- growth, copying, and destruction all behave like the real
// thing, just without exception safety (a failed allocation from
// cxx_runtime.cpp's operator new returns null here rather than throwing
// std::bad_alloc, matching every other allocation failure in this
// codebase).
//
// Picked up in place of the real <vector> via -nostdinc++ (see the
// Makefile's CXXFLAGS/FLOAT_CXXFLAGS) plus -Iinclude putting this
// directory first on the search path.

#include <stddef.h>

namespace std {

template <typename T>
class vector {
public:
    vector() : data_(nullptr), size_(0), capacity_(0) {}

    vector(const vector &other) : data_(nullptr), size_(0), capacity_(0) {
        assign_from(other);
    }

    vector &operator=(const vector &other) {
        if (this != &other) {
            clear();
            reserve(other.size_);
            assign_from(other);
        }
        return *this;
    }

    ~vector() { destroy_all(); ::operator delete[](data_); }

    size_t size() const { return size_; }
    size_t capacity() const { return capacity_; }
    bool empty() const { return size_ == 0; }

    T &operator[](size_t index) { return data_[index]; }
    const T &operator[](size_t index) const { return data_[index]; }
    T &front() { return data_[0]; }
    T &back() { return data_[size_ - 1]; }
    T *data() { return data_; }
    const T *data() const { return data_; }

    T *begin() { return data_; }
    T *end() { return data_ + size_; }
    const T *begin() const { return data_; }
    const T *end() const { return data_ + size_; }

    void reserve(size_t new_capacity) {
        if (new_capacity <= capacity_) return;
        T *grown = static_cast<T *>(::operator new[](new_capacity * sizeof(T)));
        for (size_t i = 0; i < size_; ++i) {
            new (&grown[i]) T(static_cast<T &&>(data_[i]));
            data_[i].~T();
        }
        ::operator delete[](data_);
        data_ = grown;
        capacity_ = new_capacity;
    }

    void push_back(const T &value) {
        if (size_ == capacity_) reserve(capacity_ == 0 ? 4 : capacity_ * 2);
        new (&data_[size_]) T(value);
        ++size_;
    }

    void pop_back() {
        if (size_ == 0) return;
        --size_;
        data_[size_].~T();
    }

    void resize(size_t new_size) {
        if (new_size < size_) {
            for (size_t i = new_size; i < size_; ++i) data_[i].~T();
        } else if (new_size > size_) {
            reserve(new_size);
            for (size_t i = size_; i < new_size; ++i) new (&data_[i]) T();
        }
        size_ = new_size;
    }

    void clear() { destroy_all(); size_ = 0; }

private:
    void destroy_all() { for (size_t i = 0; i < size_; ++i) data_[i].~T(); }

    void assign_from(const vector &other) {
        reserve(other.size_);
        for (size_t i = 0; i < other.size_; ++i) new (&data_[i]) T(other.data_[i]);
        size_ = other.size_;
    }

    T *data_;
    size_t size_;
    size_t capacity_;
};

}  // namespace std

// Freestanding placement new -- libstdc++'s own <new> declares this too,
// but that header isn't available here (see this file's own header
// comment on -nostdinc++), so the vector/string shims declare it once
// each, guarded separately from the include-once guard above since both
// headers can be included in the same translation unit.
#ifndef DEMON_FREESTANDING_PLACEMENT_NEW
#define DEMON_FREESTANDING_PLACEMENT_NEW
inline void *operator new(size_t, void *ptr) noexcept { return ptr; }
#endif

#endif
