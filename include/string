#ifndef DEMON_FREESTANDING_STRING
#define DEMON_FREESTANDING_STRING

// Minimal freestanding std::string, same reasoning as include/vector: real
// libstdc++'s <string> doesn't build under -ffreestanding -fno-exceptions
// -nostdlib. A real small implementation (always heap-backed, no small-
// string optimization -- correctness over that particular perf trick)
// covering the subset EDE-vintage code actually leans on: construction
// from a C string, concatenation, indexing, comparison, c_str().

#include <stddef.h>

namespace std {

class string {
public:
    string() : data_(empty_buffer()), size_(0), capacity_(0) {}

    string(const char *text) {
        size_ = length_of(text);
        capacity_ = size_;
        data_ = allocate(capacity_ + 1);
        copy_bytes(data_, text, size_);
        data_[size_] = '\0';
    }

    string(const string &other) {
        size_ = other.size_;
        capacity_ = size_;
        data_ = allocate(capacity_ + 1);
        copy_bytes(data_, other.data_, size_);
        data_[size_] = '\0';
    }

    string &operator=(const string &other) {
        if (this != &other) {
            release();
            size_ = other.size_;
            capacity_ = size_;
            data_ = allocate(capacity_ + 1);
            copy_bytes(data_, other.data_, size_);
            data_[size_] = '\0';
        }
        return *this;
    }

    string &operator=(const char *text) {
        release();
        size_ = length_of(text);
        capacity_ = size_;
        data_ = allocate(capacity_ + 1);
        copy_bytes(data_, text, size_);
        data_[size_] = '\0';
        return *this;
    }

    ~string() { release(); }

    size_t size() const { return size_; }
    size_t length() const { return size_; }
    bool empty() const { return size_ == 0; }
    const char *c_str() const { return data_; }
    const char *data() const { return data_; }

    char &operator[](size_t index) { return data_[index]; }
    char operator[](size_t index) const { return data_[index]; }

    string &operator+=(const char *text) { return append(text, length_of(text)); }
    string &operator+=(char ch) { return append(&ch, 1); }
    string &operator+=(const string &other) { return append(other.data_, other.size_); }

    string substr(size_t start, size_t count = npos) const {
        if (start >= size_) return string();
        size_t actual = count;
        if (actual == npos || start + actual > size_) actual = size_ - start;
        string result;
        result.release();
        result.size_ = actual;
        result.capacity_ = actual;
        result.data_ = allocate(actual + 1);
        copy_bytes(result.data_, data_ + start, actual);
        result.data_[actual] = '\0';
        return result;
    }

    void clear() { release(); data_ = empty_buffer(); size_ = 0; capacity_ = 0; }

    static const size_t npos = static_cast<size_t>(-1);

private:
    static size_t length_of(const char *text) {
        size_t n = 0;
        while (text != nullptr && text[n] != '\0') ++n;
        return n;
    }
    static void copy_bytes(char *dst, const char *src, size_t n) {
        for (size_t i = 0; i < n; ++i) dst[i] = src[i];
    }
    static char *allocate(size_t bytes) {
        return static_cast<char *>(::operator new[](bytes));
    }
    static char *empty_buffer() {
        static char zero = '\0';
        return &zero;
    }

    string &append(const char *text, size_t text_len) {
        const size_t new_size = size_ + text_len;
        char *grown = allocate(new_size + 1);
        copy_bytes(grown, data_, size_);
        copy_bytes(grown + size_, text, text_len);
        grown[new_size] = '\0';
        release();
        data_ = grown;
        size_ = new_size;
        capacity_ = new_size;
        return *this;
    }

    void release() {
        if (capacity_ > 0) ::operator delete[](data_);
    }

    char *data_;
    size_t size_;
    size_t capacity_;
};

inline bool operator==(const string &left, const string &right) {
    if (left.size() != right.size()) return false;
    for (size_t i = 0; i < left.size(); ++i)
        if (left[i] != right[i]) return false;
    return true;
}
inline bool operator==(const string &left, const char *right) {
    size_t i = 0;
    for (; i < left.size(); ++i) {
        if (right[i] == '\0' || left[i] != right[i]) return false;
    }
    return right[i] == '\0';
}
inline bool operator!=(const string &left, const string &right) { return !(left == right); }
inline bool operator!=(const string &left, const char *right) { return !(left == right); }

inline string operator+(const string &left, const string &right) {
    string result(left);
    result += right;
    return result;
}
inline string operator+(const string &left, const char *right) {
    string result(left);
    result += right;
    return result;
}

}  // namespace std

#ifndef DEMON_FREESTANDING_PLACEMENT_NEW
#define DEMON_FREESTANDING_PLACEMENT_NEW
inline void *operator new(size_t, void *ptr) noexcept { return ptr; }
#endif

#endif
