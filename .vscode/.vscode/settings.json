{
  "search.useIgnoreFiles": true,
  "search.useGlobalIgnoreFiles": true,

  "search.exclude": {
    "**/.git": true,
    "**/.vscode": true,
    "**/bin": true,
    "**/obj": true,
    "**/build": true,
    "**/dist": true,
    "**/out": true,
    "**/target": true,
    "**/result": true,
    "**/.direnv": true,
    "**/.cache": true,
    "**/node_modules": true,
    "**/iso": true,
    "**/*.iso": true,
    "**/*.img": true,
    "**/*.qcow2": true
  },

  "files.watcherExclude": {
    "**/.git/**": true,
    "**/bin/**": true,
    "**/obj/**": true,
    "**/build/**": true,
    "**/dist/**": true,
    "**/out/**": true,
    "**/target/**": true,
    "**/result/**": true,
    "**/.direnv/**": true,
    "**/.cache/**": true,
    "**/node_modules/**": true,
    "**/iso/**": true
  }
}
