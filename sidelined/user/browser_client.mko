use "sdk.mko";
use "../../user/mako_std.mko";
use "../../user/mako_bytes.mko";

# Demon Web is a native MKO document browser. Its start document comes from
# the kernel's checksum-validated E1000/DHCP/DNS/TCP/HTTP transaction through
# the capability-gated NETWORK ABI. The client is a persistent process,
# editable location field, keyboard and mouse navigation, multiple rendered
# documents, and a shared surface owned by the client.

fn history_store(history_address: u64, lengths_address: u64, index: u64,
                 location_address: u64, location_length: u64) -> u64 {
    if location_length > 47 { location_length = 47; }
    slot_address: u64 = history_address + index * 48;
    MakoBytes.zero(slot_address, 48);
    MakoBytes.copy(slot_address, location_address, location_length);
    lengths: vptr<u64> = vptr_from_u64(lengths_address);
    vptr_write_u64(vptr_offset_u64(lengths, index), location_length);
    return location_length;
}

fn history_restore(history_address: u64, lengths_address: u64, index: u64,
                   location_address: u64) -> u64 {
    lengths: vptr<u64> = vptr_from_u64(lengths_address);
    location_length: u64 = vptr_read_u64(vptr_offset_u64(lengths, index));
    MakoBytes.zero(location_address, 64);
    MakoBytes.copy(location_address, history_address + index * 48, location_length);
    return location_length;
}

# The "desktop.win" prefix comes from a real string literal now instead of
# 11 hand-written vptr_write_u8 byte codes -- see
# docs/mako-userspace-improvements.md's Finding 3 and counter_client.mko's
# identical helper.
fn write_event_name(name: vptr<u8>, pid: u64) -> u64 {
    prefix_address: u64 = "desktop.win";
    prefix: vptr<u8> = vptr_from_u8(prefix_address);
    index: u64 = 0;
    while index < 11 {
        vptr_write_u8(vptr_offset_u8(name, index), vptr_read_u8(vptr_offset_u8(prefix, index)));
        index = index + 1;
    }
    vptr_write_u8(vptr_offset_u8(name, 11), 48 + pid - (pid / 10) * 10);
    return 0;
}

fn glyph_mask(character: u64) -> u64 {
    if character >= 65 and character <= 90 { character = character + 32; }
    if character == 48 { return 15623448110; } if character == 49 { return 15170932932; }
    if character == 50 { return 33357578798; } if character == 51 { return 16660251151; }
    if character == 52 { return 8891181448; } if character == 53 { return 16660268095; }
    if character == 54 { return 15621129262; } if character == 55 { return 2216829471; }
    if character == 56 { return 15621113390; } if character == 57 { return 15587034670; }
    if character == 97 { return 18842895918; } if character == 98 { return 16694887983; }
    if character == 99 { return 32246891582; } if character == 100 { return 16694953519; }
    if character == 101 { return 33321092159; } if character == 102 { return 1108837439; }
    if character == 103 { return 32801457214; } if character == 104 { return 18842895921; }
    if character == 105 { return 15170932878; } if character == 106 { return 15621177872; }
    if character == 107 { return 18560947505; } if character == 108 { return 33320633377; }
    if character == 109 { return 18842572657; } if character == 110 { return 18842703473; }
    if character == 111 { return 15621211694; } if character == 112 { return 1108854319; }
    if character == 113 { return 23946905134; } if character == 114 { return 18561353263; }
    if character == 115 { return 16660235326; } if character == 116 { return 4433514655; }
    if character == 117 { return 15621211697; } if character == 118 { return 4648912433; }
    if character == 119 { return 11464787505; } if character == 120 { return 18834663985; }
    if character == 121 { return 4433521201; } if character == 122 { return 33321787935; }
    if character == 45 { return 1015808; } if character == 46 { return 13287555072; }
    if character == 47 { return 1118480; } if character == 58 { return 207624384; }
    return 0;
}

fn set_pixel(pixels: vptr<u64>, x: u64, y: u64,
             color: u64, strip_y: u64) -> u64 {
    if x >= 256 or y < strip_y or y >= strip_y + 16 { return 0; }
    local: u64 = x + (y - strip_y) * 256;
    word_offset: u64 = local / 2;
    word: u64 = vptr_read_u64(vptr_offset_u64(pixels, word_offset));
    if local - word_offset * 2 == 0 {
        word = color + (word / 4294967296) * 4294967296;
    } else {
        word = MakoStd.low32(word) + color * 4294967296;
    }
    vptr_write_u64(vptr_offset_u64(pixels, word_offset), word);
    return 0;
}

fn fill_rect(pixels: vptr<u64>, x: u64, y: u64, width: u64, height: u64,
             color_strip: u64) -> u64 {
    color: u64 = MakoStd.low32(color_strip);
    strip_y: u64 = color_strip / 4294967296;
    row: u64 = 0;
    while row < height {
        column: u64 = 0;
        while column < width {
            set_pixel(pixels, x + column, y + row, color, strip_y);
            column = column + 1;
        }
        row = row + 1;
    }
    return 0;
}

fn draw_character(pixels: vptr<u64>, x: u64, y: u64,
                  character: u64, color: u64, strip_y: u64) -> u64 {
    mask: u64 = glyph_mask(character);
    index: u64 = 0;
    divisor: u64 = 1;
    while index < 35 {
        bit: u64 = mask / divisor;
        bit = bit - (bit / 2) * 2;
        if bit == 1 {
            row: u64 = index / 5;
            column: u64 = index - row * 5;
            set_pixel(pixels, x + column, y + row, color, strip_y);
        }
        divisor = divisor * 2;
        index = index + 1;
    }
    return 0;
}

fn draw_text(pixels: vptr<u64>, address: u64, length: u64,
             x: u64, y: u64, color_strip: u64) -> u64 {
    color: u64 = MakoStd.low32(color_strip);
    strip_y: u64 = color_strip / 4294967296;
    position: u64 = 0;
    draw_x: u64 = x;
    draw_y: u64 = y;
    while position < length and draw_y < 62 {
        character: u64 = MakoBytes.byte_at(address, position);
        if character == 10 {
            draw_x = x;
            draw_y = draw_y + 9;
        } else {
            draw_character(pixels, draw_x, draw_y, character, color, strip_y);
            draw_x = draw_x + 6;
            if draw_x > 248 {
                draw_x = x;
                draw_y = draw_y + 9;
            }
        }
        position = position + 1;
    }
    return 0;
}

fn set_location(location_address: u64, page: u64) -> u64 {
    MakoBytes.zero(location_address, 64);
    location: vptr<u64> = vptr_from_u64(location_address);
    vptr_write_u64(location, MakoStd.pack32(1869440356, 791624302));
    if page == 0 {
        vptr_write_u64(vptr_offset_u64(location, 1), 1701670760);
        return 12;
    }
    if page == 1 {
        vptr_write_u64(vptr_offset_u64(location, 1), MakoStd.pack32(1970233953, 116));
        return 13;
    }
    if page == 2 {
        vptr_write_u64(vptr_offset_u64(location, 1), MakoStd.pack32(2004116846, 7041647));
        return 15;
    }
    vptr_write_u64(vptr_offset_u64(location, 1), MakoStd.pack32(1701603686, 115));
    return 13;
}

fn set_readme_location(location_address: u64) -> u64 {
    MakoBytes.zero(location_address, 64);
    location: vptr<u64> = vptr_from_u64(location_address);
    vptr_write_u64(location, MakoStd.pack32(1701603686, 791621434));
    vptr_write_u64(vptr_offset_u64(location, 1),
                   MakoStd.pack32(1145128274, 1831748941));
    vptr_write_u64(vptr_offset_u64(location, 2), MakoStd.pack32(100, 0));
    return 17;
}

fn set_web_location(location_address: u64) -> u64 {
    MakoBytes.zero(location_address, 64);
    words: vptr<u64> = vptr_from_u64(location_address);
    vptr_write_u64(words, MakoStd.pack32(1886680168, 1697591098));
    vptr_write_u64(vptr_offset_u64(words, 1), MakoStd.pack32(1886216568, 1663985004));
    vptr_write_u64(vptr_offset_u64(words, 2), 28015);
    return 18;
}

fn set_page(page_address: u64, page: u64) -> u64 {
    MakoBytes.zero(page_address, 512);
    words: vptr<u64> = vptr_from_u64(page_address);
    if page == 0 {
        vptr_write_u64(words, MakoStd.pack32(1330464068, 1163337806));
        vptr_write_u64(vptr_offset_u64(words, 1), MakoStd.pack32(1095633474, 1163282772));
        vptr_write_u64(vptr_offset_u64(words, 2), MakoStd.pack32(1129268256, 1313164629));
        vptr_write_u64(vptr_offset_u64(words, 3), MakoStd.pack32(1380065364, 1163089743));
        vptr_write_u64(vptr_offset_u64(words, 4), MakoStd.pack32(540084818, 1162694472));
        vptr_write_u64(vptr_offset_u64(words, 5), MakoStd.pack32(1092629024, 1414876994));
        vptr_write_u64(vptr_offset_u64(words, 6), MakoStd.pack32(1310733088, 1331123269));
        vptr_write_u64(vptr_offset_u64(words, 7), MakoStd.pack32(874531666, 1279870496));
        vptr_write_u64(vptr_offset_u64(words, 8), MakoStd.pack32(889869125, 1095062048));
        vptr_write_u64(vptr_offset_u64(words, 9), MakoStd.pack32(541412676, 1411404367));
        vptr_write_u64(vptr_offset_u64(words, 10), MakoStd.pack32(541413465, 1381310529));
        vptr_write_u64(vptr_offset_u64(words, 11), MakoStd.pack32(76, 0));
        return 89;
    }
    if page == 1 {
        vptr_write_u64(words, MakoStd.pack32(1431257665, 1162092628));
        vptr_write_u64(vptr_offset_u64(words, 1), MakoStd.pack32(1330532173, 1634601555));
        vptr_write_u64(vptr_offset_u64(words, 2), MakoStd.pack32(1702259060, 1330335008));
        vptr_write_u64(vptr_offset_u64(words, 3), MakoStd.pack32(1886413088, 1633905004));
        vptr_write_u64(vptr_offset_u64(words, 4), MakoStd.pack32(1852795252, 2036689674));
        vptr_write_u64(vptr_offset_u64(words, 5), MakoStd.pack32(1918988130, 539697252));
        vptr_write_u64(vptr_offset_u64(words, 6), MakoStd.pack32(1937076077, 1852383333));
        vptr_write_u64(vptr_offset_u64(words, 7), MakoStd.pack32(175404400, 1830842222));
        vptr_write_u64(vptr_offset_u64(words, 8), MakoStd.pack32(1969972079, 112));
        return 69;
    }
    if page == 2 {
        vptr_write_u64(words, MakoStd.pack32(1465140558, 541807183));
        vptr_write_u64(vptr_offset_u64(words, 1), MakoStd.pack32(1413567571, 1309299541));
        vptr_write_u64(vptr_offset_u64(words, 2), MakoStd.pack32(1411400521, 1210077251));
        vptr_write_u64(vptr_offset_u64(words, 3), MakoStd.pack32(542135380, 544501614));
        vptr_write_u64(vptr_offset_u64(words, 4), MakoStd.pack32(1818850658, 1702436980));
        vptr_write_u64(vptr_offset_u64(words, 5), MakoStd.pack32(1869351540, 543973731));
        vptr_write_u64(vptr_offset_u64(words, 6), MakoStd.pack32(1701273968, 1870078067));
        vptr_write_u64(vptr_offset_u64(words, 7), MakoStd.pack32(1847618418, 1762293615));
        vptr_write_u64(vptr_offset_u64(words, 8), MakoStd.pack32(1919251566, 544499054));
        vptr_write_u64(vptr_offset_u64(words, 9), MakoStd.pack32(1701670755, 1701716083));
        vptr_write_u64(vptr_offset_u64(words, 10), 29816);
        return 82;
    }
    if page == 3 {
        vptr_write_u64(words, MakoStd.pack32(1094930252, 1229332556));
        vptr_write_u64(vptr_offset_u64(words, 1), MakoStd.pack32(173229388, 1162893652));
        vptr_write_u64(vptr_offset_u64(words, 2), MakoStd.pack32(1279870496, 791624261));
        vptr_write_u64(vptr_offset_u64(words, 3), MakoStd.pack32(1095062063, 776293700));
        vptr_write_u64(vptr_offset_u64(words, 4), MakoStd.pack32(1326072909, 1229332562));
        vptr_write_u64(vptr_offset_u64(words, 5), MakoStd.pack32(792347980, 1498623791));
        vptr_write_u64(vptr_offset_u64(words, 6), MakoStd.pack32(1296389203, 1262570799));
        vptr_write_u64(vptr_offset_u64(words, 7), MakoStd.pack32(1095577423, 1162234190));
        vptr_write_u64(vptr_offset_u64(words, 8), MakoStd.pack32(1412322387, 1376408664));
        vptr_write_u64(vptr_offset_u64(words, 9), MakoStd.pack32(1396982085, 1162368032));
        vptr_write_u64(vptr_offset_u64(words, 10), MakoStd.pack32(1095062048, 1095901260));
        vptr_write_u64(vptr_offset_u64(words, 11), MakoStd.pack32(5457485, 0));
        return 91;
    }
    vptr_write_u64(words, MakoStd.pack32(1162297680, 1414483488));
    vptr_write_u64(vptr_offset_u64(words, 1), MakoStd.pack32(1431258656, 1409958990));
    vptr_write_u64(vptr_offset_u64(words, 2), MakoStd.pack32(1142970706, 1313819973));
    vptr_write_u64(vptr_offset_u64(words, 3), MakoStd.pack32(1211051834, 172313935));
    vptr_write_u64(vptr_offset_u64(words, 4), MakoStd.pack32(1176523343, 977620041));
    vptr_write_u64(vptr_offset_u64(words, 5), MakoStd.pack32(1378823983, 1296318789));
    vptr_write_u64(vptr_offset_u64(words, 6), MakoStd.pack32(1145908805, 0));
    return 52;
}

fn page_from_location(location_address: u64, length: u64) -> u64 {
    words: vptr<u64> = vptr_from_u64(location_address);
    first: u64 = vptr_read_u64(words);
    second: u64 = vptr_read_u64(vptr_offset_u64(words, 1));
    if (length == 4 and MakoStd.low32(first) == 1701670760) { return 0; }
    if (length == 5 and MakoStd.low32(first) == 1970233953) { return 1; }
    if (length == 7 and MakoStd.low32(first) == 2004116846 and MakoStd.low32(second) == 7041647) { return 2; }
    if (length == 5 and MakoStd.low32(first) == 1701603686 and MakoStd.low32(second) == 115) { return 3; }
    if (first == MakoStd.pack32(1869440356, 791624302)) {
        if (length == 12 and MakoStd.low32(second) == 1701670760) { return 0; }
        if (length == 13 and second == MakoStd.pack32(1970233953, 116)) { return 1; }
        if (length == 15 and second == MakoStd.pack32(2004116846, 7041647)) { return 2; }
        if (length == 13 and second == MakoStd.pack32(1701603686, 115)) { return 3; }
    }
    return 4;
}

fn load_document(storage: u64, network: u64, location_address: u64,
                 location_length: u64, page_address: u64) -> u64 {
    page: u64 = page_from_location(location_address, location_length);
    if page < 4 { return set_page(page_address, page); }
    first: u64 = vptr_read_u64(vptr_from_u64(location_address));
    if location_length >= 7 and MakoStd.low32(first) == 1886680168 {
        MakoBytes.zero(page_address, 512);
        amount: u64 = MakoAbi.network_http_get(network, location_address,
                                               location_length,
                                               page_address, 512);
        if amount > 512 {
            amount = MakoAbi.network_http_receive(network, page_address, 512);
        }
        if amount <= 512 { return amount; }
        return set_page(page_address, 4);
    }
    if location_length > 8 and
       first == MakoStd.pack32(1701603686, 791621434) {
        file: u64 = MakoAbi.file_open(storage, location_address + 7,
                                     location_length - 7, 0);
        if file <= 4294967295 {
            MakoBytes.zero(page_address, 512);
            amount: u64 = MakoAbi.handle_read(file, page_address, 512);
            MakoAbi.handle_close(file);
            if amount <= 512 { return amount; }
        }
    }
    return set_page(page_address, 4);
}

fn redraw(surface: u64, pixel_address: u64, location_address: u64,
          location_length: u64, page_address: u64, page_length: u64) -> u64 {
    pixels: vptr<u64> = vptr_from_u64(pixel_address);
    strip: u64 = 0;
    while strip < 4 {
        strip_y: u64 = strip * 16;
        background: u64 = 4278915616;
        packed: u64 = background + background * 4294967296;
        word: u64 = 0;
        while word < 2048 {
            vptr_write_u64(vptr_offset_u64(pixels, word), packed);
            word = word + 1;
        }
        fill_rect(pixels, 0, 0, 256, 13, MakoStd.pack32(4280432975, strip_y));
        fill_rect(pixels, 1, 1, 11, 11, MakoStd.pack32(4282405215, strip_y));
        fill_rect(pixels, 13, 1, 11, 11, MakoStd.pack32(4282405215, strip_y));
        fill_rect(pixels, 25, 1, 11, 11, MakoStd.pack32(4282405215, strip_y));
        fill_rect(pixels, 37, 1, 11, 11, MakoStd.pack32(4282405215, strip_y));
        fill_rect(pixels, 50, 2, 187, 9, MakoStd.pack32(4278717713, strip_y));
        fill_rect(pixels, 241, 3, 8, 7, MakoStd.pack32(4291191320, strip_y));
        draw_character(pixels, 4, 3, 98, 4293257195, strip_y);
        draw_character(pixels, 16, 3, 102, 4293257195, strip_y);
        draw_character(pixels, 28, 3, 104, 4293257195, strip_y);
        draw_character(pixels, 40, 3, 114, 4293257195, strip_y);
        draw_text(pixels, location_address, location_length, 53, 3,
                  MakoStd.pack32(4293257195, strip_y));
        draw_text(pixels, page_address, page_length, 5, 17,
                  MakoStd.pack32(4293257195, strip_y));
        if MakoAbi.surface_write(surface, pixel_address, 4096,
                                 strip * 4096) != 4096 { return 1; }
        strip = strip + 1;
    }
    if MakoAbi.surface_damage(surface, 0, 0, 256, 64) != 0 { return 1; }
    return 0;
}

fn browser_client_main(compositor_name: u64) -> u64 {
    packet_address: u64 = 3342336;
    pixel_address: u64 = packet_address + 128;
    name_address: u64 = pixel_address + 16384;
    location_address: u64 = name_address + 16;
    page_address: u64 = location_address + 64;
    history_address: u64 = page_address + 512;
    history_lengths_address: u64 = history_address + 192;
    pid: u64 = MakoAbi.getpid();
    write_event_name(vptr_from_u8(name_address), pid);
    event_server: u64 = MakoAbi.channel_create(name_address, 12);
    compositor: u64 = MakoAbi.channel_connect(compositor_name, 18);
    factory: u64 = MakoAbi.service_open(9);
    storage: u64 = MakoAbi.service_open(4);
    network: u64 = MakoAbi.service_open(10);
    surface: u64 = MakoAbi.surface_create(factory, 256, 64);
    if surface > 4294967295 or storage > 4294967295 or
       network > 4294967295 {
        MakoAbi.exit(130); return 130;
    }

    page: u64 = 4;
    location_length: u64 = set_web_location(location_address);
    page_length: u64 = load_document(storage, network, location_address,
                                     location_length, page_address);
    history_index: u64 = 0;
    history_count: u64 = 1;
    MakoBytes.zero(history_address, 224);
    history_store(history_address, history_lengths_address, 0,
                  location_address, location_length);
    if redraw(surface, pixel_address, location_address, location_length,
              page_address, page_length) != 0 {
        MakoAbi.exit(131); return 131;
    }

    shared_surface: u64 = MakoAbi.surface_share(surface, compositor);
    packet: vptr<u64> = vptr_from_u64(packet_address);
    word: u64 = 0;
    while word < 8 {
        vptr_write_u64(vptr_offset_u64(packet, word), 0);
        word = word + 1;
    }
    vptr_write_u64(packet, MakoStd.pack32(131073, 1));
    vptr_write_u64(vptr_offset_u64(packet, 1), pid);
    vptr_write_u64(vptr_offset_u64(packet, 2), MakoStd.pack32(148, 92));
    vptr_write_u64(vptr_offset_u64(packet, 3), MakoStd.pack32(328, 120));
    vptr_write_u64(vptr_offset_u64(packet, 4), shared_surface);
    if MakoAbi.channel_send(compositor, packet_address, 64) != 64 {
        MakoAbi.exit(132); return 132;
    }
    MakoAbi.handle_close(compositor);
    MakoAbi.handle_close(factory);

    location: vptr<u8> = vptr_from_u8(location_address);
    while true {
        if MakoAbi.channel_receive(event_server, packet_address, 64, 0) != 64 {
            MakoAbi.exit(133); return 133;
        }
        header: u64 = MakoStd.low32(vptr_read_u64(packet));
        if header == 720897 {
            coordinates: u64 = vptr_read_u64(vptr_offset_u64(packet, 2));
            click_x: u64 = MakoStd.low32(coordinates);
            click_y: u64 = coordinates / 4294967296;
            if click_y >= 36 and click_y < 52 {
                if click_x < 20 {
                    if history_index > 0 {
                        history_index = history_index - 1;
                        location_length = history_restore(history_address,
                            history_lengths_address, history_index, location_address);
                        page = page_from_location(location_address, location_length);
                        page_length = load_document(storage, network, location_address,
                                                    location_length, page_address);
                    }
                } else if click_x < 35 {
                    if history_index + 1 < history_count {
                        history_index = history_index + 1;
                        location_length = history_restore(history_address,
                            history_lengths_address, history_index, location_address);
                        page = page_from_location(location_address, location_length);
                        page_length = load_document(storage, network, location_address,
                                                    location_length, page_address);
                    }
                } else if click_x < 50 {
                    page = 0;
                    location_length = set_location(location_address, page);
                    page_length = set_page(page_address, page);
                    if history_index < 3 { history_index = history_index + 1; }
                    history_count = history_index + 1;
                    history_store(history_address, history_lengths_address,
                                  history_index, location_address, location_length);
                } else if click_x < 65 {
                    page = page_from_location(location_address, location_length);
                    page_length = load_document(storage, network, location_address,
                                                location_length, page_address);
                } else {
                    MakoBytes.zero(location_address, 64);
                    location_length = 0;
                }
            } else if click_y >= 52 {
                page = page + 1;
                if page > 3 { page = 0; }
                location_length = set_location(location_address, page);
                page_length = set_page(page_address, page);
                if history_index < 3 { history_index = history_index + 1; }
                history_count = history_index + 1;
                history_store(history_address, history_lengths_address,
                              history_index, location_address, location_length);
            }
        } else {
            key_word: u64 = vptr_read_u64(vptr_offset_u64(packet, 2));
            event_type: u64 = key_word - (key_word / 65536) * 65536;
            character: u64 = MakoStd.low32(vptr_read_u64(vptr_offset_u64(packet, 3)));
            if event_type == 1 {
                if character == 8 {
                    if location_length > 0 { location_length = location_length - 1; }
                } else if character == 10 {
                    page = page_from_location(location_address, location_length);
                    page_length = load_document(storage, network, location_address,
                                                location_length, page_address);
                    if history_index < 3 { history_index = history_index + 1; }
                    history_count = history_index + 1;
                    history_store(history_address, history_lengths_address,
                                  history_index, location_address, location_length);
                } else if character >= 49 and character <= 52 {
                    page = character - 49;
                    location_length = set_location(location_address, page);
                    page_length = set_page(page_address, page);
                    if history_index < 3 { history_index = history_index + 1; }
                    history_count = history_index + 1;
                    history_store(history_address, history_lengths_address,
                                  history_index, location_address, location_length);
                } else if character == 53 {
                    location_length = set_readme_location(location_address);
                    page = 4;
                    page_length = load_document(storage, network, location_address,
                                                location_length, page_address);
                    if history_index < 3 { history_index = history_index + 1; }
                    history_count = history_index + 1;
                    history_store(history_address, history_lengths_address,
                                  history_index, location_address, location_length);
                } else if character >= 32 and character <= 126 and location_length < 32 {
                    if character >= 65 and character <= 90 { character = character + 32; }
                    vptr_write_u8(vptr_offset_u8(location, location_length), character);
                    location_length = location_length + 1;
                }
            }
        }
        if redraw(surface, pixel_address, location_address, location_length,
                  page_address, page_length) != 0 {
            MakoAbi.exit(134); return 134;
        }
    }
    return 0;
}
