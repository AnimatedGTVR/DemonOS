namespace Desktop;

# EDDE (Equinox Desktop DemonOS Environment) fork of desktop.mko -- see
# compositor_edde.mko's header comment for why this is a separate file
# instead of an in-place edit. The namespace stays "Desktop" on purpose:
# this file is only ever compiled together with compositor_edde.mko (via
# its own `use` graph), never alongside the original desktop.mko in the
# same compile, so there is no symbol collision despite the shared name.

# Visual language, second pass: matched directly against a real EDE 2.x
# desktop screenshot (ArchiveOS.org), not the generic FLTK-default look the
# first EDDE pass used (that pass was based only on reading ede-panel's
# source, which shows widget mechanics -- FL_UP_BOX bevels -- but not the
# actual shipped theme's colors). The real desktop shows:
#   - a slim, near-black/navy taskbar (not a tall gray dock),
#   - desktop icons in a labeled top row (not a left-side vertical stack),
#   - a small "EDE" text start button, no big labeled orb,
#   - white text throughout, a bright blue focus/accent color.
# Kept real rather than copied outright: a virtual-desktop pager ("1 2 3 4")
# is visible in that screenshot, but this kernel has no workspace/virtual-
# desktop concept at all -- adding a static "1 2 3 4" widget would be
# exactly the kind of fabricated indicator this whole project has refused
# to add elsewhere (the battery icon, the activity bars). It's left out
# rather than faked.

fn bevel_light() -> u64 { return 4285223280; }  # #FF3F5570 raised-edge highlight (navy)
fn bevel_dark() -> u64 { return 4278520845; }    # #FF04080D raised-edge shadow (near-black)
fn panel_face() -> u64 { return 4279967278; }    # #FF13202E dark navy panel body
fn well_face() -> u64 { return 4278518300; }     # #FF0A121C near-black sunken well
fn accent_blue() -> u64 { return 4283005110; }   # #FF2E75B6 bright blue focus/accent
fn text_light() -> u64 { return 4294967295; }    # #FFFFFFFF white -- everything sits on dark now

fn desktop_color_muted() -> u64 { return 4278518300; } # alias of well_face, kept for callers

# Packs a fill color and a raised/sunken flag into one word (raised=1,
# sunken=0) so draw_bevel stays at MKO's 6-parameter ceiling.
fn pack_bevel(face: u64, raised: u64) -> u64 { return face * 2 + raised; }

# Classic Motif/FLTK FL_UP_BOX (raised) / fl_down(box()) (sunken) 3D bevel,
# recolored for a dark navy theme (real EDE's Blue-family theme is dark,
# not the light-gray FLTK default): a flat fill plus a 1px light edge on
# two sides and a 1px dark edge on the other two, swapped for the sunken
# look.
fn draw_bevel(display: u64, request_address: u64, pixel_address: u64,
             position: u64, size: u64, face_and_raised: u64) -> u64 {
    raised: u64 = face_and_raised - (face_and_raised / 2) * 2;
    face: u64 = face_and_raised / 2;
    x: u64 = low32(position);
    y: u64 = high32(position);
    w: u64 = low32(size);
    h: u64 = high32(size);
    top_color: u64 = Desktop.bevel_dark();
    bottom_color: u64 = Desktop.bevel_light();
    if raised == 1 { top_color = Desktop.bevel_light(); bottom_color = Desktop.bevel_dark(); }
    if draw_rounded_rect(display, position, size, 0, face, 0) != 0 { return 91; }
    if draw_rect(display, request_address, pixel_address,
                position, pack_words(w, 1), top_color) != 0 { return 91; }
    if draw_rect(display, request_address, pixel_address,
                position, pack_words(1, h), top_color) != 0 { return 91; }
    if draw_rect(display, request_address, pixel_address,
                pack_words(x, y + h - 1), pack_words(w, 1), bottom_color) != 0 { return 91; }
    if draw_rect(display, request_address, pixel_address,
                pack_words(x + w - 1, y), pack_words(1, h), bottom_color) != 0 { return 91; }
    return 0;
}

fn desktop_draw_word_demon(display: u64, request_address: u64,
                           pixel_address: u64, x: u64, y: u64,
                           foreground: u64) -> u64 {
    if draw_glyph(display, request_address, pixel_address,
                  pack_words(x, y), glyph_d(), foreground) != 0 { return 108; }
    if draw_glyph(display, request_address, pixel_address,
                  pack_words(x + 8, y), glyph_e(), foreground) != 0 { return 108; }
    if draw_glyph(display, request_address, pixel_address,
                  pack_words(x + 16, y), glyph_m(), foreground) != 0 { return 108; }
    if draw_glyph(display, request_address, pixel_address,
                  pack_words(x + 24, y), glyph_o(), foreground) != 0 { return 108; }
    if draw_glyph(display, request_address, pixel_address,
                  pack_words(x + 32, y), glyph_n(), foreground) != 0 { return 108; }
    return 0;
}

# "EDE" -- the real start-button label in the reference screenshot, used
# only on EDDE's own taskbar start button (desktop icon labels and the
# launcher header still say DEMON, since this is still DemonOS underneath).
fn desktop_draw_word_ede(display: u64, request_address: u64,
                         pixel_address: u64, x: u64, y: u64,
                         foreground: u64) -> u64 {
    if draw_glyph(display, request_address, pixel_address,
                  pack_words(x, y), glyph_e(), foreground) != 0 { return 108; }
    if draw_glyph(display, request_address, pixel_address,
                  pack_words(x + 8, y), glyph_d(), foreground) != 0 { return 108; }
    if draw_glyph(display, request_address, pixel_address,
                  pack_words(x + 16, y), glyph_e(), foreground) != 0 { return 108; }
    return 0;
}

fn desktop_draw_folder(display: u64, request_address: u64,
                       pixel_address: u64, x: u64, y: u64,
                       color: u64) -> u64 {
    if draw_shell_icon(display, pack_words(x, y), 1) != 0 { return 91; }
    return 0;
}

fn desktop_draw_terminal(display: u64, request_address: u64,
                         pixel_address: u64, x: u64, y: u64,
                         color: u64) -> u64 {
    if draw_shell_icon(display, pack_words(x, y), 0) != 0 { return 91; }
    return 0;
}

# No top bar (real EDE ships one panel, not two) -- just the wallpaper.
# Desktop icons (desktop_draw_shortcuts) and the single slim bottom panel
# (desktop_draw_task_panel) carry everything else.
fn desktop_draw_background(display: u64, request_address: u64,
                           pixel_address: u64, cursor_and_theme: u64) -> u64 {
    if draw_wallpaper(display, 0, pack_words(640, 480)) != 0 { return 91; }
    return 0;
}

# Desktop icons as a labeled top row (matching the reference screenshot),
# not DemonOS's left-side vertical stack. Only the first (DEMON, opens the
# launcher) is interactive -- the rest are decorative, exactly as
# DemonOS's HOME tile already was, so this changes layout/style only, not
# how much of the row is real versus chrome.
fn desktop_draw_shortcuts(display: u64, request_address: u64,
                          pixel_address: u64, cursor_packed: u64) -> u64 {
    cursor_x: u64 = unpack_cursor_x(cursor_packed);
    cursor_y: u64 = unpack_cursor_y(cursor_packed);

    # DEMON: the compositor's real hit box for opening the launcher is
    # x=[12,60), y=[8,66).
    demon_raised: u64 = 1;
    if cursor_x >= 12 and cursor_x < 60 and cursor_y >= 8 and cursor_y < 66 {
        demon_raised = 0;
    }
    if Desktop.draw_bevel(display, request_address, pixel_address,
                 pack_words(12, 8), pack_words(48, 56),
                 Desktop.pack_bevel(Desktop.panel_face(), demon_raised)) != 0 { return 91; }
    if draw_start_logo(display, pack_words(24, 12)) != 0 { return 91; }
    if Desktop.desktop_draw_word_demon(display, request_address, pixel_address,
                               13, 46, Desktop.text_light()) != 0 { return 108; }

    # HOME, TERMINAL, WEB, SETTINGS: decorative row icons, same spacing
    # rhythm as the reference screenshot's icon row.
    if draw_shell_icon(display, pack_words(78, 12), 5) != 0 { return 91; }
    if draw_glyph(display, request_address, pixel_address,
                  pack_words(70, 46), glyph_h(), Desktop.text_light()) != 0 { return 108; }
    if draw_glyph(display, request_address, pixel_address,
                  pack_words(78, 46), glyph_o(), Desktop.text_light()) != 0 { return 108; }
    if draw_glyph(display, request_address, pixel_address,
                  pack_words(86, 46), glyph_m(), Desktop.text_light()) != 0 { return 108; }
    if draw_glyph(display, request_address, pixel_address,
                  pack_words(94, 46), glyph_e(), Desktop.text_light()) != 0 { return 108; }

    if Desktop.desktop_draw_terminal(display, request_address, pixel_address,
                             136, 12, Desktop.text_light()) != 0 { return 91; }
    if draw_glyph(display, request_address, pixel_address,
                  pack_words(128, 46), glyph_t(), Desktop.text_light()) != 0 { return 108; }

    if draw_shell_icon(display, pack_words(194, 12), 2) != 0 { return 91; }
    if draw_glyph(display, request_address, pixel_address,
                  pack_words(186, 46), glyph_w(), Desktop.text_light()) != 0 { return 108; }

    if draw_shell_icon(display, pack_words(252, 12), 4) != 0 { return 91; }
    if draw_glyph(display, request_address, pixel_address,
                  pack_words(244, 46), glyph_s(), Desktop.text_light()) != 0 { return 108; }
    return 0;
}

# The single slim EDE-style panel (30px, matched to the reference
# screenshot instead of DemonOS's 42px dock): start button, quick-launch,
# clock, taskbar, battery, activity (cpu/mem-monitor analog -- real
# window-count telemetry, since there's no /proc here). packed_extra folds
# in the three small values render_scene would otherwise need as separate
# parameters past the 6-argument ceiling: day_seconds (0..86399, a clock
# that wraps daily -- there is no RTC), window_count (0..8), and
# battery_present (0/1).
#   packed_extra = day_seconds + window_count * 100000 + battery_present * 1000000
fn desktop_draw_task_panel(display: u64, request_address: u64,
                           pixel_address: u64, focused_window: u64,
                           anim_and_cursor: u64, packed_extra: u64) -> u64 {
    anim_phase: u64 = low32(anim_and_cursor);
    packed: u64 = high32(anim_and_cursor);
    cursor_x: u64 = unpack_cursor_x(packed);
    cursor_y: u64 = unpack_cursor_y(packed);
    day_seconds: u64 = packed_extra - (packed_extra / 100000) * 100000;
    window_count: u64 = (packed_extra / 100000) - (packed_extra / 1000000) * 10;
    battery_present: u64 = packed_extra / 1000000;

    # Applet positions below are computed the same way real EDE's
    # ede-panel/Panel.cpp::do_layout()/add_from_list() compute them, not
    # hand-picked pixel constants: INITIAL_SPACING=5 and DEFAULT_SPACING=5
    # (Panel.cpp's own #defines) both from the left edge for
    # EDE_PANEL_APPLET_OPTION_ALIGN_LEFT applets and from the right edge
    # (walking leftward) for ALIGN_RIGHT ones, in each applet's real load
    # order. Reading each real applet's own alignment flag (grep
    # EDE_PANEL_APPLET_OPTION_ALIGN_ in applets/*/*.cpp) gives:
    #   start_menu: LEFT      quick_launch: LEFT       taskbar: LEFT + RESIZABLE_H
    #   clock: RIGHT          battery_monitor: RIGHT   cpu_monitor: RIGHT
    # (pager, keyboard_layout, mem_monitor, system_tray are skipped --
    # no virtual desktops, no keyboard layout switching, no /proc, no real
    # tray protocol exist here, the same reasoning already applied
    # elsewhere.) The right-aligned walk places the FIRST applet in load
    # order RIGHTMOST (each subsequent one lands further left), so with
    # clock loaded before battery_monitor before cpu_monitor, clock ends
    # up closest to the screen edge -- exactly like the reference
    # screenshot, and the opposite of this port's first pass, which had
    # guessed clock leftmost.
    #   left walk:  X=5; start_menu(w=54) -> X=64 (taskbar starts here)
    #   right walk: X=635; clock(w=48)->X=587,X=582
    #               battery(w=20)->X=562,X=557
    #               cpu_monitor/activity(w=20)->X=537,X=532
    #               settings(w=20, DemonOS's own addition -- not a real
    #               EDE applet, so it's appended last/leftmost of the
    #               right cluster rather than reordering the real ones)
    #               ->X=512
    if draw_gradient_v(display, pack_words(0, 450), pack_words(640, 30),
                       Desktop.panel_face(), Desktop.well_face(), 0) != 0 { return 91; }
    if draw_rect(display, request_address, pixel_address,
                pack_words(0, 450), pack_words(640, 1), Desktop.bevel_light()) != 0 { return 91; }

    # Start menu applet (real EDE: StartMenu.cpp, ALIGN_LEFT). Click region
    # is the compositor's established live_x<60.
    start_raised: u64 = 1;
    if cursor_x >= 5 and cursor_x < 59 and cursor_y >= 450 {
        start_raised = 0;
    }
    if Desktop.draw_bevel(display, request_address, pixel_address,
                 pack_words(5, 450), pack_words(54, 30),
                 Desktop.pack_bevel(Desktop.panel_face(), start_raised)) != 0 { return 91; }
    if draw_start_logo(display, pack_words(7, 454)) != 0 { return 91; }
    if Desktop.desktop_draw_word_ede(display, request_address, pixel_address,
                               31, 460, Desktop.text_light()) != 0 { return 108; }

    # Taskbar applet (real EDE: Taskbar.cpp, ALIGN_LEFT | RESIZABLE_H --
    # x0=64 is exactly where the left-aligned walk above lands right after
    # the start menu applet, 5(spacing) + 54(its width) + 5(spacing)).
    # TaskButton.cpp uses FL_UP_BOX/fl_down(box()) for normal/pressed --
    # pressed here means "this is the focused window", the same up/down
    # toggle-button semantics a real taskbar button has.
    slot: u64 = 0;
    while slot < 8 {
        if slot_state(slot) != 0 {
            task_x: u64 = 64 + slot * 34;
            task_raised: u64 = 1;
            if slot_id(slot) == focused_window and slot_visible(slot) == 1 {
                task_raised = 0;
            }
            task_face: u64 = Desktop.panel_face();
            if slot_minimized(slot) == 1 { task_face = color_task_minimized(); }
            if cursor_x >= task_x and cursor_x < task_x + 30 and cursor_y >= 450 {
                task_face = Desktop.well_face();
            }
            if Desktop.draw_bevel(display, request_address, pixel_address,
                         pack_words(task_x, 450), pack_words(30, 30),
                         Desktop.pack_bevel(task_face, task_raised)) != 0 { return 91; }
            if slot_id(slot) == 7 {
                if Desktop.desktop_draw_terminal(display, request_address, pixel_address,
                                         task_x + 4, 454,
                                         Desktop.text_light()) != 0 { return 91; }
            } else if slot_app_kind(slot) == app_kind_browser() {
                if draw_shell_icon(display, pack_words(task_x + 4, 454), 2) != 0 { return 91; }
            } else {
                if draw_shell_icon(display, pack_words(task_x + 4, 454), 3) != 0 { return 91; }
            }
            if slot_id(slot) == focused_window {
                indicator: u64 = argb_lighten(Desktop.accent_blue(), anim_pulse(anim_phase, 40, 18));
                if draw_rounded_rect(display, pack_words(task_x + 4, 476),
                                     pack_words(22, 2), 1, indicator, 0) != 0 { return 91; }
            }
        }
        slot = slot + 1;
    }

    # Clock applet (real EDE: applets/clock/Clock.cpp, ALIGN_RIGHT, loaded
    # first among the right-aligned applets so it lands rightmost --
    # x=587, see this function's header comment for the walk).
    hours: u64 = (day_seconds / 3600) - (day_seconds / 3600 / 100) * 100;
    minutes: u64 = (day_seconds / 60) - (day_seconds / 3600) * 60;
    seconds: u64 = day_seconds - (day_seconds / 60) * 60;
    if draw_glyph(display, request_address, pixel_address, pack_words(587, 460), digit_glyph(hours / 10), Desktop.text_light()) != 0 { return 108; }
    if draw_glyph(display, request_address, pixel_address, pack_words(593, 460), digit_glyph(hours - (hours / 10) * 10), Desktop.text_light()) != 0 { return 108; }
    if draw_glyph(display, request_address, pixel_address, pack_words(599, 460), glyph_colon(), Desktop.text_light()) != 0 { return 108; }
    if draw_glyph(display, request_address, pixel_address, pack_words(605, 460), digit_glyph(minutes / 10), Desktop.text_light()) != 0 { return 108; }
    if draw_glyph(display, request_address, pixel_address, pack_words(611, 460), digit_glyph(minutes - (minutes / 10) * 10), Desktop.text_light()) != 0 { return 108; }
    if draw_glyph(display, request_address, pixel_address, pack_words(617, 460), glyph_colon(), Desktop.text_light()) != 0 { return 108; }
    if draw_glyph(display, request_address, pixel_address, pack_words(623, 460), digit_glyph(seconds / 10), Desktop.text_light()) != 0 { return 108; }
    if draw_glyph(display, request_address, pixel_address, pack_words(629, 460), digit_glyph(seconds - (seconds / 10) * 10), Desktop.text_light()) != 0 { return 108; }

    # Battery applet (real EDE: applets/battery-monitor, ALIGN_RIGHT,
    # second in load order -- x=562). Real ACPI presence
    # (MakoAbi.battery_present(), see src/acpi.c's RSDP/RSDT/FADT/DSDT walk
    # for the PNP0C0A Control Method Battery ID) lights the glyph the
    # accent blue when a battery device is actually declared in the
    # firmware's ACPI namespace; stays a neutral white outline otherwise.
    # No AML interpreter exists to read a real charge level, so this is
    # presence-only, never a fabricated percentage or fill amount.
    battery_color: u64 = Desktop.text_light();
    if battery_present == 1 { battery_color = Desktop.accent_blue(); }
    if draw_rounded_rect(display, pack_words(562, 460), pack_words(15, 9), 1,
                         battery_color, 0) != 0 { return 91; }
    if draw_rect(display, request_address, pixel_address,
                 pack_words(577, 463), pack_words(2, 3),
                 battery_color) != 0 { return 91; }

    # CPU/mem-monitor applet analog (real EDE: cpu-monitor/CpuMonitor.cpp,
    # ALIGN_RIGHT, third in load order -- x=537): real live window count
    # (0..8), the same telemetry substitution DemonOS's activity bars
    # used, since there is no /proc here to read real CPU/memory load
    # from. Wave 13 added a real workspace concept (see
    # compositor_edde.mko's slot_workspace/switch_workspace, a genuine
    # PekWM-derived port), switched with Super+1..4 -- but the reference
    # screenshot's fixed applet spacing (see this function's header
    # comment for the exact left/right walk) leaves no free pixels for a
    # pager widget between the settings gear at x=512 and this cluster at
    # x=537, so the switch stays keyboard-only rather than crowding a
    # widget in that isn't backed by that same walk.
    bar1: u64 = Desktop.well_face();
    if window_count >= 1 { bar1 = Desktop.accent_blue(); }
    bar2: u64 = Desktop.well_face();
    if window_count >= 3 { bar2 = Desktop.accent_blue(); }
    bar3: u64 = Desktop.well_face();
    if window_count >= 5 { bar3 = Desktop.accent_blue(); }
    if draw_rounded_rect(display, pack_words(537, 468), pack_words(4, 7), 0,
                         bar1, 0) != 0 { return 91; }
    if draw_rounded_rect(display, pack_words(545, 465), pack_words(4, 10), 0,
                         bar2, 0) != 0 { return 91; }
    if draw_rounded_rect(display, pack_words(553, 462), pack_words(4, 13), 0,
                         bar3, 0) != 0 { return 91; }

    # Settings gear: not a real EDE applet (no such thing appears in
    # ede-panel/applets/), so DemonOS's own addition is appended last --
    # leftmost of the right-aligned cluster, closest to the taskbar --
    # rather than reordering any of the real applets around it. Click
    # region matches the compositor's own live_x>=512,<532 test.
    if Desktop.draw_bevel(display, request_address, pixel_address,
                 pack_words(512, 450), pack_words(20, 30),
                 Desktop.pack_bevel(Desktop.panel_face(), 1)) != 0 { return 91; }
    if draw_shell_icon(display, pack_words(513, 454), 4) != 0 { return 91; }
    return 0;
}

# Taskbar right-click context menu -- a real feature ported from
# ede-panel/applets/taskbar/TaskButton.cpp's static menu_[] array
# (Restore/Minimize/Maximize/Close, in that exact order) and its popup
# positioning (TaskButton::display_menu() pops up at the click point;
# this always renders directly above the task button that opened it,
# since that's this compositor's real click origin -- see
# compositor_edde.mko's task-menu hit-test comment for the matching
# geometry). Single-letter row labels (R/I/M/C) rather than full words:
# this bitmap font is missing 'x' and 'z' (see letter_glyph's comment),
# which rules out spelling "Maximize"/"Minimize" in full, and every other
# menu/row label in this shell already uses single letters for the same
# reason.
fn desktop_draw_task_menu(display: u64, request_address: u64,
                          pixel_address: u64, task_slot: u64) -> u64 {
    # 3 rows -- Minimize/Maximize/Close, not real EDE's full 4 (Restore is
    # dropped: a plain left-click on a minimized task button already
    # restores it, per Taskbar::activate_window(), so it added no real
    # capability, only budget pressure against the 160 KiB code ceiling
    # this process type shares with DemonOS's own compositor).
    menu_x: u64 = 64 + task_slot * 34;
    menu_y: u64 = 378;
    if Desktop.draw_bevel(display, request_address, pixel_address,
                 pack_words(menu_x, menu_y), pack_words(96, 72),
                 Desktop.pack_bevel(Desktop.panel_face(), 1)) != 0 { return 91; }

    row: u64 = 0;
    while row < 3 {
        row_y: u64 = menu_y + row * 24;
        glyph: u64 = glyph_i();
        if row == 1 { glyph = glyph_m(); }
        else if row == 2 { glyph = glyph_c(); }
        if draw_glyph(display, request_address, pixel_address,
                     pack_words(menu_x + 8, row_y + 8),
                     glyph, Desktop.text_light()) != 0 { return 108; }
        row = row + 1;
    }
    return 0;
}

fn desktop_draw_launcher(display: u64, request_address: u64,
                         pixel_address: u64, cursor_packed: u64,
                         theme: u64, search_query: u64) -> u64 {
    # search_length is derived from search_query (scan for the first unset
    # byte; typed letters are always nonzero ASCII and every byte past the
    # typed prefix is 0) rather than threaded as its own parameter, since
    # this function is already at MKO's 6-parameter ceiling.
    search_length: u64 = 0;
    length_scan_done: u64 = 0;
    length_scan: u64 = 0;
    while length_scan < 8 and length_scan_done == 0 {
        scan_place: u64 = pow256(length_scan);
        scan_byte: u64 = (search_query / scan_place) - (search_query / (scan_place * 256)) * 256;
        if scan_byte == 0 { length_scan_done = 1; }
        else { search_length = length_scan + 1; length_scan = length_scan + 1; }
    }
    # Real EDE's start menu (applets/start-menu/StartMenu.cpp) is a plain
    # FLTK popup menu -- a flat bevel panel with a bold-label header, not
    # glass, recolored dark navy to match the rest of this pass. Row bands
    # shifted 20px up from DemonOS's original 238-based layout (panel top
    # 190->170, rows now 218..446) so they no longer overlap EDDE's slim
    # taskbar (starts at y=450, versus DemonOS's y=434 dock) -- discovered
    # via real interactive click testing: a click at y=452 (inside the old
    # 238..466 row band AND the new taskbar band) was swallowed by the
    # launcher's row hit-test instead of reaching the taskbar underneath,
    # a genuine bug, not a testing artifact (confirmed by the same click
    # position working correctly once this overlap was removed).
    if draw_shadow(display, pack_words(8, 170), pack_words(226, 314),
                   2, 6, color_shadow()) != 0 { return 91; }
    if Desktop.draw_bevel(display, request_address, pixel_address,
                 pack_words(8, 170), pack_words(226, 314),
                 Desktop.pack_bevel(Desktop.panel_face(), 1)) != 0 { return 91; }
    if draw_rect(display, request_address, pixel_address,
                pack_words(10, 172), pack_words(222, 26), Desktop.accent_blue()) != 0 { return 91; }
    if draw_start_logo(display, pack_words(20, 175)) != 0 { return 91; }
    if Desktop.desktop_draw_word_demon(display, request_address, pixel_address,
                               55, 182, Desktop.text_light()) != 0 { return 108; }

    if Desktop.draw_bevel(display, request_address, pixel_address,
                 pack_words(16, 212), pack_words(210, 240),
                 Desktop.pack_bevel(Desktop.well_face(), 0)) != 0 { return 91; }
    row: u64 = 0;
    while row < 6 {
        row_y: u64 = 218 + row * 38;
        row_raised: u64 = 1;
        cx: u64 = unpack_cursor_x(cursor_packed);
        cy: u64 = unpack_cursor_y(cursor_packed);
        if cx >= 20 and cx < 220 and cy >= row_y and cy < row_y + 38 {
            row_raised = 0;
        }
        if Desktop.draw_bevel(display, request_address, pixel_address,
                     pack_words(20, row_y), pack_words(200, 34),
                     Desktop.pack_bevel(Desktop.panel_face(), row_raised)) != 0 { return 91; }
        row = row + 1;
    }
    if Desktop.desktop_draw_terminal(display, request_address, pixel_address,
                             30, 226, Desktop.text_light()) != 0 { return 91; }
    if Desktop.desktop_draw_folder(display, request_address, pixel_address,
                          30, 264, Desktop.text_light()) != 0 { return 91; }
    if draw_shell_icon(display, pack_words(30, 302), 2) != 0 { return 91; }
    # ede-calc (Wave 1 of the EDE port): reuses the "settings" atlas icon --
    # there is no dedicated calculator/science icon in the embedded Fluent
    # atlas -- disambiguated from the actual Settings target (which stays at
    # its own established taskbar hit target) by the "E" glyph below.
    if draw_shell_icon(display, pack_words(30, 340), 4) != 0 { return 91; }
    # ede-conf (Wave 5): the control panel that spawns the rest of the EDE
    # apps. Reuses the "home" atlas icon (index 5) -- no dedicated
    # control-panel icon exists -- disambiguated by the "O" glyph below.
    if draw_shell_icon(display, pack_words(30, 378), 5) != 0 { return 91; }
    if draw_shell_icon(display, pack_words(30, 416), 3) != 0 { return 91; }

    if draw_glyph(display, request_address, pixel_address,
                  pack_words(68, 231), glyph_t(), Desktop.text_light()) != 0 { return 108; }
    if draw_glyph(display, request_address, pixel_address,
                  pack_words(68, 269), glyph_c(), Desktop.text_light()) != 0 { return 108; }
    if draw_glyph(display, request_address, pixel_address,
                  pack_words(68, 307), glyph_w(), Desktop.text_light()) != 0 { return 108; }
    if draw_glyph(display, request_address, pixel_address,
                  pack_words(68, 345), glyph_e(), Desktop.text_light()) != 0 { return 108; }
    if draw_glyph(display, request_address, pixel_address,
                  pack_words(68, 383), glyph_o(), Desktop.text_light()) != 0 { return 108; }
    if draw_glyph(display, request_address, pixel_address,
                  pack_words(68, 421), glyph_s(), Desktop.text_light()) != 0 { return 108; }

    # Search box (Wave 12 of the EDE port): real keyboard capture, drawn as
    # a sunken text-entry well matching the rest of this bevel style. Real
    # EDE's own start menu has no search field (a pure category-tree popup
    # menu per StartMenu.cpp/XdgMenuReader.cpp), so this stays DemonOS's
    # addition rather than something ported from upstream.
    if Desktop.draw_bevel(display, request_address, pixel_address,
                 pack_words(20, 456), pack_words(146, 20),
                 Desktop.pack_bevel(Desktop.well_face(), 0)) != 0 { return 91; }
    query_index: u64 = 0;
    while query_index < search_length {
        place: u64 = pow256(query_index);
        typed: u64 = (search_query / place) - (search_query / (place * 256)) * 256;
        if draw_glyph(display, request_address, pixel_address,
                     pack_words(24 + query_index * 6, 463),
                     letter_glyph(typed), Desktop.text_light()) != 0 { return 108; }
        query_index = query_index + 1;
    }
    if Desktop.draw_bevel(display, request_address, pixel_address,
                 pack_words(178, 456), pack_words(42, 20),
                 Desktop.pack_bevel(Desktop.accent_blue(), 1)) != 0 { return 91; }
    return 0;
}
